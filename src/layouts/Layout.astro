---
import "../sass/styles.scss";

import Header from "../components/Header.astro";
import Footer from "../layouts/Footer.astro";

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<title>{title ? `${title} - GQR Labs` : "GQR Labs - Software y Ciberseguridad"}</title>
		<meta name="description" content={description ?? "Desarrollo de software y Ciberseguridad. Montevideo, Uruguay."} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href="https://gqrlabs.com/" />

		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Exo+2:wght@400;700&family=Noto+Sans+Display:wght@400;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
	</body>
</html>
