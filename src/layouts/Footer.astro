---
import "../sass/base/layout/_footer.scss";
import LinkedinLogo from "../assets/icons/linkedin-logo.png";
import EmailLogo from "../assets/icons/mail-logo.png";
import {Image} from "astro:assets";

const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="footer__principal-container">
		<div class="footer__brand-area">
			<!-- Brand -->
			<div class="footer__brand">
				<div class="footer__company-name">
					<span class="footer__name">GQR Labs</span>
				</div>
				<span class="footer__company-tagline">
					Desarrollo de Software y Ciberseguridad
				</span>
			</div>

			<!-- Social -->
			<div class="footer__social">
				<a
					href="https://linkedin.com"
					class="footer__social-link"
					target="_blank"
					rel="noopener"
				>
					<Image
						src={LinkedinLogo}
						width={36}
						height={36}
						densities={[1, 2, 3]}
						alt="LinkedIn Logo"
					/>
				</a>
				<a href="mailto:gqrlabs@gmail.com" class="footer__social-link">
					<Image
						src={EmailLogo}
						width={36}
						height={36}
						densities={[1, 2, 3]}
						alt="Mail Logo"
					/>
				</a>
			</div>
		</div>
	</div>
</footer>
