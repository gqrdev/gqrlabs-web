---
import "../../sass/components/partials/_mentorships.scss";
---

<section class="mentorships" id="mentorship">
	<div class="wrapper">
		<!-- Header -->
		<div class="mentorships__header">
			<span class="mentorships__pretitle">Mentorías 1:1</span>

			<h2 class="mentorships__title">
				Aprendé sobre seguridad <span class="mentorships__accent"
					>a tu manera</span
				>
			</h2>
		</div>

		<!-- Description -->
		<p class="mentorships__description">
			No todas las necesidades requieren el mismo recorrido. Por eso, las
			mentorías se adaptan a lo que querés resolver, aprender o profundizar.
			Desde una sesión puntual para analizar una situación concreta, hasta un
			proceso más completo para desarrollar conocimientos y ganar autonomía,
			cada propuesta parte de tus objetivos y de tu contexto.
		</p>

		<!-- Timeline -->
		<div class="mentorships__timeline">
			<span class="mentorships__timeline-line"></span>

			<!-- Plan 1 -->
			<article class="mentorships__item">
				<div class="mentorships__card">
					<span class="mentorships__step"> Punto de partida </span>

					<h3 class="mentorships__item-title">Mentoría 1:1</h3>

					<p class="mentorships__item-description">
						Un espacio individual para entender una situación, resolver dudas y
						encontrar caminos concretos para avanzar.
					</p>

					<ul class="mentorships__features">
						<li>Una sesión individual.</li>
						<li>Análisis de tu situación.</li>
						<li>Explicaciones claras y prácticas.</li>
					</ul>
				</div>
			</article>

			<!-- Dot -->
			<span class="mentorships__dot"></span>

			<!-- Plan 2 -->
			<article class="mentorships__item">
				<div class="mentorships__card">
					<span class="mentorships__step"> Para avanzar </span>

					<h3 class="mentorships__item-title">Curso personalizado</h3>

					<p class="mentorships__item-description">
						Un recorrido de 4 sesiones creado alrededor de un objetivo
						específico, con contenidos, ejemplos y materiales adaptados a vos.
					</p>

					<ul class="mentorships__features">
						<li>Programa adaptado a tus objetivos.</li>
						<li>4 sesiones individuales.</li>
						<li>Ejemplos y situaciones reales.</li>
					</ul>
				</div>
			</article>

			<!-- Dot -->
			<span class="mentorships__dot"></span>

			<!-- Plan 3 -->
			<article class="mentorships__item">
				<div class="mentorships__card">
					<span class="mentorships__step"> +Extendido </span>

					<h3 class="mentorships__item-title">Programa avanzado</h3>

					<p class="mentorships__item-description">
						Un proceso más profundo y progresivo para trabajar diferentes áreas,
						consolidar conocimientos y desarrollar autonomía.
					</p>

					<ul class="mentorships__features">
						<li>Programa diseñado desde cero.</li>
						<li>Múltiples sesiones individuales.</li>
						<li>Profundización en diferentes temas.</li>
					</ul>
				</div>
			</article>
		</div>

		<!-- Actions -->
		<div class="mentorships__actions">
			<p class="mentorships__hint">¿Te ayudamos a elegir?</p>

			<a href="/mentorias" class="mentorships__cta"> Quiero mas info </a>
		</div>
	</div>
</section>
