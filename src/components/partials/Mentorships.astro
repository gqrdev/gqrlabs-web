---
import "../../sass/components/partials/_mentorships.scss";
---

<section class="mentorships" id="mentorship">
	<div class="wrapper">
		<!-- Header -->
		<div class="mentorships__header">
			<span class="mentorships__pretitle">Mentorías 1:1</span>

			<h2 class="mentorships__title">
				Aprendé sobre seguridad
				<span class="mentorships__accent">a tu manera</span>
			</h2>
		</div>

		<!-- Description -->
		<p class="mentorships__description">
			No todas las personas necesitan aprender lo mismo ni de la misma manera.
			Por eso, podés elegir entre distintas modalidades según lo que quieras
			resolver, aprender o profundizar.
		</p>

		<!-- Timeline -->
		<div class="mentorships__timeline">
			<!-- Línea continua -->
			<span class="mentorships__timeline-line"></span>

			<!-- Plan 1 -->
			<article class="mentorships__item">
				<div class="mentorships__card">
					<span class="mentorships__step"> Punto de partida </span>

					<h3 class="mentorships__item-title">Mentoría 1:1</h3>

					<p class="mentorships__item-description">
						Una sesión individual para analizar una situación concreta, resolver
						dudas o profundizar en un tema específico.
					</p>

					<ul class="mentorships__features">
						<li>Una sesión individual.</li>
						<li>Análisis de tu situación.</li>
						<li>Explicaciones claras y prácticas.</li>
					</ul>
				</div>
			</article>

			<!-- Dot -->
			<span class="mentorships__dot"></span>

			<!-- Plan 2 -->
			<article class="mentorships__item">
				<div class="mentorships__card">
					<span class="mentorships__step"> Para avanzar </span>

					<h3 class="mentorships__item-title">Curso personalizado</h3>

					<p class="mentorships__item-description">
						Un recorrido corto creado alrededor de un objetivo concreto, con
						contenidos y ejemplos adaptados a tus necesidades.
					</p>

					<ul class="mentorships__features">
						<li>Programa adaptado a tus objetivos.</li>
						<li>4 sesiones individuales.</li>
						<li>Ejemplos y situaciones reales.</li>
					</ul>
				</div>
			</article>

			<!-- Dot -->
			<span class="mentorships__dot"></span>

			<!-- Plan 3 -->
			<article class="mentorships__item">
				<div class="mentorships__card">
					<span class="mentorships__step"> Profundización </span>

					<h3 class="mentorships__item-title">Programa personalizado</h3>

					<p class="mentorships__item-description">
						Un recorrido más completo para profundizar en diferentes temas,
						construir conocimientos de forma progresiva y ganar autonomía.
					</p>

					<ul class="mentorships__features">
						<li>Programa diseñado desde cero.</li>
						<li>Múltiples sesiones individuales.</li>
						<li>Profundización en diferentes temas.</li>
					</ul>
				</div>
			</article>
		</div>

		<!-- Footer -->
		<div class="mentorships__footer">
			<p class="mentorships__hint">
				¿No sabés cuál elegir?
			</p>

			<a href="/mentorias" class="mentorships__cta">
				Quiero conocer las mentorías
			</a>
		</div>
	</div>
</section>
