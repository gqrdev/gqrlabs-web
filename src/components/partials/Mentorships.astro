---
import "../../sass/components/partials/_mentorships.scss";
---

<section class="mentorships" id="mentorship">
	<div class="wrapper">
		<!-- Header -->
		<div class="mentorships__header">
			<span class="mentorships__pretitle">Acompañamiento personalizado</span>

			<h2 class="mentorships__title">
				Aprendé sobre seguridad
				<span class="mentorships__accent">a tu manera</span>
			</h2>
		</div>

		<!-- Description -->
		<p class="mentorships__description">
			No necesitás ser experto en tecnología para aprender a protegerte.
			Trabajamos sobre tus necesidades, tus dudas y las situaciones que
			realmente forman parte de tu vida digital, con explicaciones claras y sin
			tecnicismos innecesarios.
		</p>

		<!-- Timeline -->
		<div class="mentorships__timeline">
			<span class="mentorships__timeline-line"></span>

			<!-- Plan 1 -->
			<article class="mentorships__item">
				<div class="mentorships__card">
					<span class="mentorships__step">Punto de partida</span>

					<h3 class="mentorships__item-title">Mentoría 1:1</h3>

					<p class="mentorships__item-description">
						Una sesión individual para analizar una situación concreta, resolver
						una duda o entender cómo actuar frente a un problema de seguridad
						digital.
					</p>
				</div>
			</article>

			<!-- Dot -->
			<span class="mentorships__dot"></span>

			<!-- Plan 2 -->
			<article class="mentorships__item">
				<div class="mentorships__card">
					<span class="mentorships__step">Más elegido</span>

					<h3 class="mentorships__item-title">Acompañamiento personalizado</h3>

					<p class="mentorships__item-description">
						Un proceso de 4 sesiones adaptado a tus necesidades para aprender a
						proteger tus cuentas, dispositivos e información con mayor seguridad
						y confianza.
					</p>
				</div>
			</article>

			<!-- Dot -->
			<span class="mentorships__dot"></span>

			<!-- Plan 3 -->
			<article class="mentorships__item">
				<div class="mentorships__card">
					<span class="mentorships__step">+ Extendido</span>

					<h3 class="mentorships__item-title">Programa integral</h3>

					<p class="mentorships__item-description">
						Un proceso de 8 sesiones o más para trabajar diferentes aspectos de
						tu seguridad digital, incorporar buenos hábitos y ganar mayor
						autonomía.
					</p>
				</div>
			</article>
		</div>

		<!-- Actions -->
		<div class="mentorships__actions">
			<p class="mentorships__hint">¿No sabés por dónde empezar?</p>

			<a href="/mentorias" class="mentorships__cta">
				Conocé cómo podemos ayudarte
			</a>
		</div>
	</div>
</section>
