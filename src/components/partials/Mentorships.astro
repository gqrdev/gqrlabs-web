---
import "../../sass/components/partials/_mentorships.scss";
---

<section class="mentorships" id="mentorship">
	<!-- Header -->
	<div class="mentorships__header">
		<span class="mentorships__pretitle">Mentorías 1 a 1</span>
		<h2 class="mentorships__title">
			Acompañamiento<span class="mentorships__accent">&nbsp;hecho a tu medida</span>
		</h2>
	</div>

	<!-- Description -->
	<p class="mentorships__description">
		Sesiones personalizadas de asesoría técnica y profesional. Analizamos tu
		código, destrabamos tus proyectos y aceleramos tu crecimiento con una hoja
		de ruta clara.
	</p>

	<!-- Grid -->
	<div class="mentorships__grid">
		<!-- Item 1 -->
		<article class="mentorships__card">
			<div class="mentorships__card-body">
				<div class="mentorships__item-header">
					<span class="mentorships__code-badge"></span>
					<h3 class="mentorships__item-title">Diagnóstico inicial</h3>
				</div>
				<p class="mentorships__item-description">
					Nos reunimos para conocer tus desafíos actuales, revisar tu proyecto o
					nivel técnico y definir prioridades claras desde el primer encuentro.
				</p>
			</div>
		</article>

		<!-- Item 2 -->
		<article class="mentorships__card">
			<div class="mentorships__card-body">
				<div class="mentorships__item-header">
					<span class="mentorships__code-badge"></span>
					<h3 class="mentorships__item-title">Roadmap y estrategia</h3>
				</div>
				<p class="mentorships__item-description">
					Diseñamos un plan de acción paso a paso enfocado en resolver tus
					bloqueos específicos, optimizar procesos y alcanzar tus metas
					profesionales.
				</p>
			</div>
		</article>

		<!-- Item 3 -->
		<article class="mentorships__card">
			<div class="mentorships__card-body">
				<div class="mentorships__item-header">
					<span class="mentorships__code-badge"></span>
					<h3 class="mentorships__item-title">Sesiones prácticas 1 a 1</h3>
				</div>
				<p class="mentorships__item-description">
					Encuentros virtuales en vivo para revisar código, aplicar buenas
					prácticas de desarrollo y resolver dudas técnicas en tiempo real.
				</p>
			</div>
		</article>
	</div>
</section>
