---
import "../../sass/components/partials/_software.scss";
import Tech from "./Tech.astro";
---

<section class="software" id="software">
	<div class="wrapper">
		<!-- Header -->
		<div class="software__header">
			<span class="software__pretitle">Software</span>
			<h2 class="software__title">
				Desarrollo de software <span class="software__accent">a medida</span>
			</h2>
		</div>

		<!-- Description -->
		<p class="software__description">
			Desarrollamos software a medida para empresas que necesitan herramientas
			adaptadas a su forma de trabajar. Creamos sistemas internos y aplicaciones
			web que ayudan a organizar la información, simplificar procesos y resolver
			necesidades concretas del negocio.
		</p>
		<p class="software__description">
			Cada solución parte de comprender qué necesitás y cómo podemos ayudarte
			mediante la tecnología.
		</p>

		<!-- Grid -->
		<div class="software__grid">
			<!-- Item 1 -->
			<article class="software__card">
				<div class="software__card-body">
					<div class="software__item-header">
						<span class="software__code-badge software__code-badge--systems"
						></span>
						<h3 class="software__item-title">Sistemas internos</h3>
					</div>
					<p class="software__item-description">
						Desarrollamos sistemas internos adaptados a los procesos de cada
						empresa. Organizamos la información y creamos herramientas que
						ayudan a reducir tareas manuales y trabajar de forma más eficiente.
					</p>
				</div>
			</article>
			<!-- Item 2 -->
			<article class="software__card">
				<div class="software__card-body">
					<div class="software__item-header">
						<span
							class="software__code-badge software__code-badge--applications"
						></span>
						<h3 class="software__item-title">Aplicaciones web</h3>
					</div>
					<p class="software__item-description">
						Creamos aplicaciones web adaptadas a las necesidades de cada
						negocio. Desarrollamos herramientas para facilitar tareas, gestionar
						información y simplificar el trabajo cotidiano de los equipos.
					</p>
				</div>
			</article>

			<!-- Item 3 -->
			<article class="software__card">
				<div class="software__card-body">
					<div class="software__item-header">
						<span
							class="software__code-badge software__code-badge--infrastructure"
						></span>
						<h3 class="software__item-title">Infraestructura segura</h3>
					</div>
					<p class="software__item-description">
						Diseñamos infraestructura cloud adaptada a las necesidades de cada
						proyecto. Buscamos que las soluciones cuenten con una base
						tecnológica segura, estable y preparada para acompañar su
						crecimiento.
					</p>
				</div>
			</article>
		</div>

		<!-- Tech Section -->
		<Tech />

		<div class="software__actions">
			<p class="software__hint">¿Buscás una solución para tu negocio?</p>
			<a href="#contacto" class="software__cta">Hablemos de tu proyecto</a>
		</div>
	</div>
</section>
