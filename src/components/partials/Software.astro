---
import "../../sass/components/partials/_software.scss";
import {Image} from "astro:assets";
import AWSLogo from "../../assets/technologies/aws-logo.png";
import GoogleCloudLogo from "../../assets/technologies/google-cloud-logo.png";
import DigitalOceanLogo from "../../assets/technologies/digital-ocean-logo.png";
import LaravelLogo from "../../assets/technologies/laravel-logo.png";
import PythonLogo from "../../assets/technologies/python-logo.png";
---

<section class="section software" id="software">
	<div class="software__container">
		<!-- Header -->
		<div class="software__header">
			<span class="software__pretitle">Software</span>
			<h2 class="software__title">
				Tecnología que &nbsp;<span class="software__accent"
					>potencia cada proyecto</span
				>
			</h2>
		</div>

		<!-- Description -->
		<p class="software__description">
			No todos los problemas necesitan la misma solución. Por eso, se combinan
			herramientas existentes con desarrollos a medida para encontrar la
			alternativa más adecuada en cada caso.
		</p>

		<!-- Grid -->
		<div class="software__grid">
			<!-- Item 1 -->
			<article class="software__card">
				<div class="software__card-body">
					<div class="software__item-header">
						<span class="software__code-badge"></span>
						<h3 class="software__item-title">Soluciones a medida</h3>
					</div>
					<p class="software__item-description">
						Cada cliente tiene su propia forma de trabajar. Entender esa
						realidad permite desarrollar herramientas que se adapten a sus
						necesidades y no al revés.
					</p>
				</div>
			</article>

			<!-- Item 2 -->
			<article class="software__card">
				<div class="software__card-body">
					<div class="software__item-header">
						<span class="software__code-badge"></span>
						<h3 class="software__item-title">Automatización e integración</h3>
					</div>
					<p class="software__item-description">
						Procesos repetitivos, información dispersa o sistemas que no se
						comunican entre sí pueden convertirse en oportunidades para
						simplificar el trabajo, reducir errores y mejorar la forma de hacer
						las cosas.
					</p>
				</div>
			</article>

			<!-- Item 3 -->
			<article class="software__card">
				<div class="software__card-body">
					<div class="software__item-header">
						<span class="software__code-badge"></span>
						<h3 class="software__item-title">Software que aporta valor</h3>
					</div>
					<p class="software__item-description">
						Las soluciones deben ser útiles, confiables y fáciles de utilizar.
						El objetivo es que la inversión en tecnología resuelva problemas
						concretos y tenga un impacto real en el día a día.
					</p>
				</div>
			</article>
		</div>

		<!-- Mini Sección Tecnologías con Animación Infinita -->
		<div class="software__tech-section">
			<div class="software__tech-title">Tecnologías que utilizamos</div>

			<div class="software__tech-wrapper">
				<div class="software__tech-track">
					<!-- Group 1 -->
					<div class="software__tech">
						<Image
							src={AWSLogo}
							alt="AWS Logo"
							width="128"
							class="software__tech-icon"
						/>
					</div>
					<div class="software__tech">
						<Image
							src={GoogleCloudLogo}
							alt="Google Cloud Logo"
							width="128"
							class="software__tech-icon"
						/>
					</div>
					<div class="software__tech">
						<Image
							src={DigitalOceanLogo}
							alt="DigitalOcean Logo"
							width="128"
							class="software__tech-icon"
						/>
					</div>
					<div class="software__tech">
						<Image
							src={LaravelLogo}
							alt="Laravel Logo"
							width="128"
							class="software__tech-icon"
						/>
					</div>
					<div class="software__tech">
						<Image
							src={PythonLogo}
							alt="Python Logo"
							width="128"
							class="software__tech-icon"
						/>
					</div>

					<!-- Group 2 -->
					<div class="software__tech">
						<Image
							src={AWSLogo}
							alt="AWS Logo"
							width="128"
							class="software__tech-icon"
						/>
					</div>
					<div class="software__tech">
						<Image
							src={GoogleCloudLogo}
							alt="Google Cloud Logo"
							width="128"
							class="software__tech-icon"
						/>
					</div>
					<div class="software__tech">
						<Image
							src={DigitalOceanLogo}
							alt="DigitalOcean Logo"
							width="128"
							class="software__tech-icon"
						/>
					</div>
					<div class="software__tech">
						<Image
							src={LaravelLogo}
							alt="Laravel Logo"
							width="128"
							class="software__tech-icon"
						/>
					</div>
					<div class="software__tech">
						<Image
							src={PythonLogo}
							alt="Python Logo"
							width="128"
							class="software__tech-icon"
						/>
					</div>
				</div>
			</div>

			<div class="software__tech-line"></div>
		</div>
	</div>
</section>
