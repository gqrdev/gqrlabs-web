---
import "../../sass/components/partials/_software.scss";
import {Image} from "astro:assets";
import AWSLogo from "../../assets/technologies/aws-logo.png";
import GoogleCloudLogo from "../../assets/technologies/google-cloud-logo.png";
import DigitalOceanLogo from "../../assets/technologies/digital-ocean-logo.png";
import LaravelLogo from "../../assets/technologies/laravel-logo.png";
import PythonLogo from "../../assets/technologies/python-logo.png";
---

<section class="software" id="software">
	<div class="wrapper">
		<!-- Header -->
		<div class="software__header">
			<span class="software__pretitle">Software</span>
			<h2 class="software__title">
				Tecnología que <span class="software__accent"
					>potencia cada proyecto.</span
				>
			</h2>
		</div>

		<!-- Description -->
		<p class="software__description">
			No todos los problemas necesitan la misma solución. Por eso, se combinan
			distintas capacidades tecnológicas con soluciones desarrolladas a medida
			para encontrar la alternativa más adecuada en cada caso.
		</p>

		<!-- Grid -->
		<div class="software__grid">
			<!-- Item 1 -->
			<article class="software__card">
				<div class="software__card-body">
					<div class="software__item-header">
						<span class="software__code-badge"></span>
						<h3 class="software__item-title">Aplicaciones web</h3>
					</div>
					<p class="software__item-description">
						Cada equipo tiene su propia manera de hacer las cosas. Por eso, una
						aplicación web no debería obligar a cambiar la forma de trabajar,
						sino adaptarse a ella, simplificar procesos y hacer que el día a día
						sea un poco más sencillo.
					</p>
				</div>
			</article>

			<!-- Item 2 -->
			<article class="software__card">
				<div class="software__card-body">
					<div class="software__item-header">
						<span class="software__code-badge"></span>
						<h3 class="software__item-title">Sistemas internos</h3>
					</div>
					<p class="software__item-description">
						Detrás de cada empresa existen procesos que muchas veces son únicos.
						Se analizan esas particularidades para desarrollar sistemas internos
						que ayuden a ordenar la información, reducir tareas innecesarias y
						trabajar de una forma más ágil.
					</p>
				</div>
			</article>

			<!-- Item 3 -->
			<article class="software__card">
				<div class="software__card-body">
					<div class="software__item-header">
						<span class="software__code-badge"></span>
						<h3 class="software__item-title">Infraestructura segura</h3>
					</div>
					<p class="software__item-description">
						Una buena herramienta también necesita un lugar donde funcionar de
						forma segura y confiable. Por eso, las soluciones se alojan en
						servicios cloud de confianza, preparados para ofrecer
						disponibilidad, seguridad y escalabilidad sin que la tecnología se
						convierta en un límite.
					</p>
				</div>
			</article>
		</div>
	</div>

	<!-- Technologies -->
	<div class="software__tech-section">
		<div class="software__tech-title">Tecnologías que utilizamos</div>

		<div class="software__tech-wrapper">
			<div class="software__tech-track">
				<!-- Group 1 -->
				<div class="software__tech">
					<Image
						src={AWSLogo}
						alt="AWS Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
				<div class="software__tech">
					<Image
						src={GoogleCloudLogo}
						alt="Google Cloud Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
				<div class="software__tech">
					<Image
						src={DigitalOceanLogo}
						alt="DigitalOcean Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
				<div class="software__tech">
					<Image
						src={LaravelLogo}
						alt="Laravel Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
				<div class="software__tech">
					<Image
						src={PythonLogo}
						alt="Python Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>

				<!-- Group 2 -->
				<div class="software__tech">
					<Image
						src={AWSLogo}
						alt="AWS Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
				<div class="software__tech">
					<Image
						src={GoogleCloudLogo}
						alt="Google Cloud Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
				<div class="software__tech">
					<Image
						src={DigitalOceanLogo}
						alt="DigitalOcean Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
				<div class="software__tech">
					<Image
						src={LaravelLogo}
						alt="Laravel Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
				<div class="software__tech">
					<Image
						src={PythonLogo}
						alt="Python Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
			</div>
		</div>

		<div class="software__tech-line"></div>
	</div>
</section>
