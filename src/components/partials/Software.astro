---
import "../../sass/components/partials/_software.scss";
---
<section class="section software" id="software">
    <div class="software__container">
        <span class="software__pretitle">Potenciamos tu negocio</span>

        <div class="software__header">
            <h2 class="software__title">
                Software
            </h2>

            <p class="software__description">
                Lorem ipsum dolor, sit amet consectetur adipisicing elit. Sed quidem
                minima sapiente tempore veritatis modi, magni assumenda unde possimus
                fugiat voluptates iste odit animi odio culpa deserunt, quo numquam in.
            </p>
        </div>

        <div class="software__list">
            <article class="software__item">
                <span class="software__number">01</span>

                <h3 class="software__item-title">Software 1</h3>

                <p class="software__item-description">Este es un ejemplo de un software.</p>

                <span class="software__arrow">↗</span>
            </article>
        </div>
    </div>
</section>