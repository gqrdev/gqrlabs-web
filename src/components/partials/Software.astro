---
import "../../sass/components/partials/_software.scss";
import {Image} from "astro:assets";
import AWSLogo from "../../assets/technologies/aws-logo.png";
import GoogleCloudLogo from "../../assets/technologies/google-cloud-logo.png";
import DigitalOceanLogo from "../../assets/technologies/digital-ocean-logo.png";
import LaravelLogo from "../../assets/technologies/laravel-logo.png";
import PythonLogo from "../../assets/technologies/python-logo.png";
---

<section class="software" id="software">
	<div class="wrapper">
		<!-- Header -->
		<div class="software__header">
			<span class="software__pretitle">Software</span>
			<h2 class="software__title">
				Tecnología que <span class="software__accent"
					>potencia cada proyecto</span
				>
			</h2>
		</div>

		<!-- Description -->
		<p class="software__description">
			No todos los problemas necesitan la misma solución. Por eso, se combinan
			distintas capacidades tecnológicas con soluciones desarrolladas a medida
			para encontrar la alternativa más adecuada en cada caso.
		</p>

		<!-- Grid -->
		<div class="software__grid">
			<!-- Item 1 -->
			<article class="software__card">
				<div class="software__card-body">
					<div class="software__item-header">
						<span class="software__code-badge"></span>
						<h3 class="software__item-title">Sistemas internos</h3>
					</div>
					<p class="software__item-description">
						Cada empresa tiene procesos que la hacen diferente. Los convertimos
						en sistemas pensados para ordenar la información, reducir tareas
						innecesarias y trabajar de una forma más ágil.
					</p>
				</div>
			</article>
			<!-- Item 2 -->
			<article class="software__card">
				<div class="software__card-body">
					<div class="software__item-header">
						<span class="software__code-badge"></span>
						<h3 class="software__item-title">Aplicaciones web</h3>
					</div>
					<p class="software__item-description">
						Cada equipo tiene su propia forma de trabajar. Por eso,
						desarrollamos aplicaciones web que se adaptan a sus necesidades,
						simplifican procesos y hacen más fácil el trabajo del día a día.
					</p>
				</div>
			</article>

			<!-- Item 3 -->
			<article class="software__card">
				<div class="software__card-body">
					<div class="software__item-header">
						<span class="software__code-badge"></span>
						<h3 class="software__item-title">Infraestructura segura</h3>
					</div>
					<p class="software__item-description">
						Una buena solución también necesita una infraestructura preparada
						para acompañarla. Utilizamos servicios cloud confiables para que
						cada proyecto pueda funcionar de forma segura, estable y con margen
						para crecer.
					</p>
				</div>
			</article>
		</div>
	</div>

	<!-- Technologies -->
	<div class="software__tech-section">
		<div class="software__tech-title"> Algunas de las tecnologías que utilizamos</div>

		<div class="software__tech-wrapper">
			<div class="software__tech-track">
				<!-- Group 1 -->
				<div class="software__tech">
					<Image
						src={AWSLogo}
						alt="AWS Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
				<div class="software__tech">
					<Image
						src={GoogleCloudLogo}
						alt="Google Cloud Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
				<div class="software__tech">
					<Image
						src={DigitalOceanLogo}
						alt="DigitalOcean Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
				<div class="software__tech">
					<Image
						src={LaravelLogo}
						alt="Laravel Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
				<div class="software__tech">
					<Image
						src={PythonLogo}
						alt="Python Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>

				<!-- Group 2 -->
				<div class="software__tech">
					<Image
						src={AWSLogo}
						alt="AWS Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
				<div class="software__tech">
					<Image
						src={GoogleCloudLogo}
						alt="Google Cloud Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
				<div class="software__tech">
					<Image
						src={DigitalOceanLogo}
						alt="DigitalOcean Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
				<div class="software__tech">
					<Image
						src={LaravelLogo}
						alt="Laravel Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
				<div class="software__tech">
					<Image
						src={PythonLogo}
						alt="Python Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>

				<!-- Group 3 -->
				<div class="software__tech">
					<Image
						src={AWSLogo}
						alt="AWS Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
				<div class="software__tech">
					<Image
						src={GoogleCloudLogo}
						alt="Google Cloud Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
				<div class="software__tech">
					<Image
						src={DigitalOceanLogo}
						alt="DigitalOcean Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
				<div class="software__tech">
					<Image
						src={LaravelLogo}
						alt="Laravel Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
				<div class="software__tech">
					<Image
						src={PythonLogo}
						alt="Python Logo"
						width="128"
						class="software__tech-icon"
					/>
				</div>
			</div>
		</div>

		<div class="software__tech-line"></div>
	</div>
</section>
