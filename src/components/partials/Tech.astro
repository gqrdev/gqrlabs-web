---
import "../../sass/components/partials/_tech-section.scss";

import {Image} from "astro:assets";
import AWSLogo from "../../assets/technologies/aws-logo.png";
import GoogleCloudLogo from "../../assets/technologies/google-cloud-logo.png";
import DigitalOceanLogo from "../../assets/technologies/digital-ocean-logo.png";
import LaravelLogo from "../../assets/technologies/laravel-logo.png";
import PythonLogo from "../../assets/technologies/python-logo.png";
---

<!-- Technologies -->
<div class="tech-section">
	<div class="tech-section__title">
		Algunas de las tecnologías que utilizamos
	</div>

	<div class="tech-section__tech-wrapper">
		<div class="tech-section__tech-track">
			<!-- Group 1 -->
			<div class="tech-section__tech">
				<Image
					src={AWSLogo}
					alt="AWS Logo"
					width="128"
					class="tech-section__tech-icon"
				/>
			</div>
			<div class="tech-section__tech">
				<Image
					src={GoogleCloudLogo}
					alt="Google Cloud Logo"
					width="128"
					class="tech-section__tech-icon"
				/>
			</div>
			<div class="tech-section__tech">
				<Image
					src={DigitalOceanLogo}
					alt="DigitalOcean Logo"
					width="128"
					class="tech-section__tech-icon"
				/>
			</div>
			<div class="tech-section__tech">
				<Image
					src={LaravelLogo}
					alt="Laravel Logo"
					width="128"
					class="tech-section__tech-icon"
				/>
			</div>
			<div class="tech-section__tech">
				<Image
					src={PythonLogo}
					alt="Python Logo"
					width="128"
					class="tech-section__tech-icon"
				/>
			</div>

			<!-- Group 2 -->
			<div class="tech-section__tech">
				<Image
					src={AWSLogo}
					alt="AWS Logo"
					width="128"
					class="tech-section__tech-icon"
				/>
			</div>
			<div class="tech-section__tech">
				<Image
					src={GoogleCloudLogo}
					alt="Google Cloud Logo"
					width="128"
					class="tech-section__tech-icon"
				/>
			</div>
			<div class="tech-section__tech">
				<Image
					src={DigitalOceanLogo}
					alt="DigitalOcean Logo"
					width="128"
					class="tech-section__tech-icon"
				/>
			</div>
			<div class="tech-section__tech">
				<Image
					src={LaravelLogo}
					alt="Laravel Logo"
					width="128"
					class="tech-section__tech-icon"
				/>
			</div>
			<div class="tech-section__tech">
				<Image
					src={PythonLogo}
					alt="Python Logo"
					width="128"
					class="tech-section__tech-icon"
				/>
			</div>

			<!-- Group 3 -->
			<div class="tech-section__tech">
				<Image
					src={AWSLogo}
					alt="AWS Logo"
					width="128"
					class="tech-section__tech-icon"
				/>
			</div>
			<div class="tech-section__tech">
				<Image
					src={GoogleCloudLogo}
					alt="Google Cloud Logo"
					width="128"
					class="tech-section__tech-icon"
				/>
			</div>
			<div class="tech-section__tech">
				<Image
					src={DigitalOceanLogo}
					alt="DigitalOcean Logo"
					width="128"
					class="tech-section__tech-icon"
				/>
			</div>
			<div class="tech-section__tech">
				<Image
					src={LaravelLogo}
					alt="Laravel Logo"
					width="128"
					class="tech-section__tech-icon"
				/>
			</div>
			<div class="tech-section__tech">
				<Image
					src={PythonLogo}
					alt="Python Logo"
					width="128"
					class="tech-section__tech-icon"
				/>
			</div>
		</div>
	</div>

	<div class="tech-section__tech-line"></div>
</div>
