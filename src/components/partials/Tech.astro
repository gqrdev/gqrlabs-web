---
import "../../sass/components/partials/_tech-section.scss";
import {Image} from "astro:assets";
import RobotImage from "../../assets/technologies/robot.png";
import AWSImage from "../../assets/technologies/aws.png";
import DataImage from "../../assets/technologies/data.png";
---

<!-- Technologies -->
<div class="software__technology">
	<h3 class="software__technology-title">
		Automatización e inteligencia artificial
	</h3>

	<div class="software__technology-diagram">
		{/* ASISTENTE VIRTUAL */}
		<div class="software__technology-node software__technology-node--chatbot">
			<Image
				src={RobotImage}
				alt="Asistente virtual de inteligencia artificial para empresas"
				width={90}
				height={90}
				fit="contain"
				class="software__technology-icon"
			/>

			<h4 class="software__technology-label">Asistente virtual de IA</h4>

			<p class="software__technology-description">Adaptado a tu negocio</p>

			<ul class="software__technology-items">
				<li class="software__technology-item">Atención automatizada 24/7</li>
				<li class="software__technology-item">
					Respuestas adaptadas a tus necesidades
				</li>
				<li class="software__technology-item">Interacción personalizada</li>
			</ul>
		</div>

		<span
			class="software__technology-link software__technology-link--chatbot"
			aria-hidden="true"
		>
			<span class="software__technology-pulse"></span>
		</span>

		{/* INFRAESTRUCTURA AWS */}
		<div class="software__technology-node software__technology-node--aws">
			<Image
				src={AWSImage}
				alt="Infraestructura cloud con Amazon Web Services AWS"
				width={90}
				height={90}
				fit="contain"
				class="software__technology-icon"
			/>

			<h4 class="software__technology-label">AWS</h4>

			<p class="software__technology-description">
				Infraestructura adaptada a cada proyecto
			</p>

			<ul class="software__technology-items">
				<li class="software__technology-item">
					Adaptada a tus necesidades
				</li>
				<li class="software__technology-item">
					Escalabilidad según demanda
				</li>
				<li class="software__technology-item">
					Servicios cloud para aplicaciones y sistemas
				</li>
			</ul>
		</div>

		<span
			class="software__technology-link software__technology-link--aws"
			aria-hidden="true"
		>
			<span class="software__technology-pulse"></span>
		</span>

		{/* INFORMACIÓN DEL CLIENTE */}
		<div class="software__technology-node software__technology-node--client">
			<Image
				src={DataImage}
				alt="Gestión y protección de la información"
				width={90}
				height={90}
				fit="contain"
				class="software__technology-icon"
			/>

			<h4 class="software__technology-label">Gestión de datos</h4>

			<p class="software__technology-description">
				Información protegida
			</p>

			<ul class="software__technology-items">
				<li class="software__technology-item">Protección de la información</li>
				<li class="software__technology-item">
					Control de acceso
				</li>
				<li class="software__technology-item">
					Información relevante para cada consulta
				</li>
			</ul>
		</div>
	</div>

	<div class="software__technology-line"></div>
</div>
