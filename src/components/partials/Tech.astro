---
import "../../sass/components/partials/_tech-section.scss";
import {Image} from "astro:assets";
import RobotImage from "../../assets/technologies/robot.png";
import AWSImage from "../../assets/technologies/aws.png";
import DataImage from "../../assets/technologies/data.png";
---

<!-- Technologies -->
<div class="software__technology">
	<h3 class="software__technology-title">
		Automatización e inteligencia artificial
	</h3>

	<div class="software__technology-diagram">
		{/* ASISTENTE VIRTUAL */}
		<div class="software__technology-node software__technology-node--chatbot">
			<Image
				src={RobotImage}
				alt="Asistente virtual con inteligencia artificial para empresas"
				width={90}
				height={90}
				fit="contain"
				class="software__technology-icon"
			/>

			<h4 class="software__technology-label">Asistentes virtuales</h4>

			<p class="software__technology-description">Adaptados a tu negocio</p>

			<ul class="software__technology-items">
				<li class="software__technology-item">Atención automatizada</li>
				<li class="software__technology-item">
					Respuestas adaptadas a cada necesidad
				</li>
				<li class="software__technology-item">Acceso ágil a la información</li>
			</ul>
		</div>

		<span
			class="software__technology-link software__technology-link--chatbot"
			aria-hidden="true"
		>
			<span class="software__technology-pulse"></span>
		</span>

		{/* INFRAESTRUCTURA AWS */}
		<div class="software__technology-node software__technology-node--aws">
			<Image
				src={AWSImage}
				alt="Infraestructura en la nube con Amazon Web Services"
				width={90}
				height={90}
				fit="contain"
				class="software__technology-icon"
			/>

			<h4 class="software__technology-label">Infraestructura AWS</h4>

			<p class="software__technology-description">
				Adaptada a cada proyecto
			</p>

			<ul class="software__technology-items">
				<li class="software__technology-item">
					Recursos según el proyecto
				</li>
				<li class="software__technology-item">
					Crece con tu negocio
				</li>
				<li class="software__technology-item">
					Servicios para aplicaciones y sistemas
				</li>
			</ul>
		</div>

		<span
			class="software__technology-link software__technology-link--aws"
			aria-hidden="true"
		>
			<span class="software__technology-pulse"></span>
		</span>

		{/* INFORMACIÓN DEL CLIENTE */}
		<div class="software__technology-node software__technology-node--client">
			<Image
				src={DataImage}
				alt="Gestión segura y organizada de la información"
				width={90}
				height={90}
				fit="contain"
				class="software__technology-icon"
			/>

			<h4 class="software__technology-label">Datos</h4>

			<p class="software__technology-description">
				Organizados y accesibles
			</p>

			<ul class="software__technology-items">
				<li class="software__technology-item">
					Gestión responsable
				</li>
				<li class="software__technology-item">
					Acceso controlado
				</li>
				<li class="software__technology-item">
					Información relevante para cada consulta
				</li>
			</ul>
		</div>
	</div>

	<div class="software__technology-line"></div>
</div>
