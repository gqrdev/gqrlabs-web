---
import "../../sass/components/partials/_tech-section.scss";
import {Image} from "astro:assets";
import RobotImage from "../../assets/technologies/robot.png";
import AWSImage from "../../assets/technologies/aws.png";
import DataImage from "../../assets/technologies/data.png";
---

<!-- Technologies -->
<div class="software__technology">
	<!-- <div class="software__technology-title">
		Algunas de las tecnologías que utilizamos
	</div> -->

	<div class="software__technology-diagram">
		<!-- ASISTENTE VIRTUAL -->
		<div class="software__technology-node software__technology-node--chatbot">
			<Image
				src={RobotImage}
				alt="Asistente virtual de inteligencia artificial"
				width={96}
				height={96}
				fit="contain"
				class="software__technology-icon"
			/>

			<p class="software__technology-label">ASISTENTE AI</p>

			<p class="software__technology-description">
				Un asistente virtual adaptado a tu negocio
			</p>

			<ul class="software__technology-items">
				<li class="software__technology-item">Atención automatizada 24/7</li>
				<li class="software__technology-item">Respuestas según tus necesidades</li>
				<li class="software__technology-item">Experiencia personalizada</li>
			</ul>
		</div>

		<span
			class="software__technology-link software__technology-link--chatbot"
			aria-hidden="true"
		>
			<span class="software__technology-pulse"></span>
		</span>

		<!-- INFRAESTRUCTURA AWS -->
		<div class="software__technology-node software__technology-node--aws">
			<Image
				src={AWSImage}
				alt="Infraestructura cloud de AWS"
				width={96}
				height={96}
				fit="contain"
				class="software__technology-icon"
			/>

			<p class="software__technology-label">AWS</p>

			<p class="software__technology-description">
				Infraestructura segura y escalable
			</p>

			<ul class="software__technology-items">
				<li class="software__technology-item">
					Arquitectura segura
				</li>
				<li class="software__technology-item">Escalabilidad según la demanda</li>
				<li class="software__technology-item">Alta disponibilidad</li>
			</ul>
		</div>

		<span class="software__technology-link software__technology-link--aws" aria-hidden="true">
			<span class="software__technology-pulse"></span>
		</span>

		<!-- INFORMACIÓN DEL CLIENTE -->
		<div class="software__technology-node software__technology-node--client">
			<Image
				src={DataImage}
				alt="Protección y gestión segura de datos"
				width={96}
				height={96}
				fit="contain"
				class="software__technology-icon"
			/>

			<p class="software__technology-label">DATOS SEGUROS</p>

			<p class="software__technology-description">
				Información protegida y acceso controlado
			</p>

			<ul class="software__technology-items">
				<li class="software__technology-item">Protección de la información</li>
				<li class="software__technology-item">Acceso según permisos</li>
				<li class="software__technology-item">Datos relevantes para cada consulta</li>
			</ul>
		</div>
	</div>

	<div class="software__technology-line"></div>
</div>
