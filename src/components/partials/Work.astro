---
import "../../sass/components/partials/_work.scss";
---

<section class="section work" id="work">
	<div class="work__container">
		<div class="work__pretitle">Proyectos / 03</div>

		<div class="work__header">
			<h2 class="work__title">
				Proyectos.
			</h2>
		</div>

		<div class="work__projects">
			<a href="#" class="project">
				<div class="project__image"></div>
				<div class="project__info">
					<div class="project__content">
						<h3 class="project__name">Name 1</h3>
						<p class="project__type">Example project</p>
					</div>
					<span class="project__year">2026</span>
				</div>
			</a>
		</div>
	</div>
</section>
