---
import "../../sass/components/partials/_training.scss";
---

<section class="training" id="capacitacion">
	<div class="wrapper">
		<!-- Header -->
		<div class="training__header">
			<span class="training__pretitle">Acompañamiento personalizado</span>

			<h2 class="training__title">
				Aprendé sobre seguridad <span class="training__accent"
					>con confianza</span
				>
			</h2>
		</div>

		<!-- Description -->
		<p class="training__description">
			No necesitás ser experto en tecnología para aprender a protegerte.
			Trabajamos sobre tus necesidades, tus dudas y las situaciones que
			realmente forman parte de tu vida digital, con explicaciones claras y sin
			tecnicismos innecesarios.
		</p>

		<!-- Timeline -->
		<div class="training__timeline">
			<span class="training__timeline-line"></span>

			<!-- Plan 1 -->
			<article class="training__item">
				<div class="training__card">
					<span class="training__step">Punto de partida</span>

					<h3 class="training__item-title">Mentoría 1:1</h3>

					<p class="training__item-description">
						Una sesión individual para analizar una situación concreta, resolver
						una duda o entender cómo actuar frente a una situación de seguridad
						digital.
					</p>
				</div>
			</article>

			<!-- Dot -->
			<span class="training__dot"></span>

			<!-- Plan 2 -->
			<article class="training__item">
				<div class="training__card">
					<span class="training__step">Más elegido</span>

					<h3 class="training__item-title">Acompañamiento personalizado</h3>

					<p class="training__item-description">
						Un proceso diseñado a tu medida, adaptado a tus necesidades,
						conocimientos y objetivos, con contenidos prácticos para aprender de
						forma clara y flexible.
					</p>
				</div>
			</article>

			<!-- Dot -->
			<span class="training__dot"></span>

			<!-- Plan 3 -->
			<article class="training__item">
				<div class="training__card">
					<span class="training__step">+ Extendido</span>

					<h3 class="training__item-title">Programa integral</h3>

					<p class="training__item-description">
						Un proceso más completo para profundizar en tus objetivos,
						desarrollar nuevas habilidades y avanzar con mayor autonomía,
						confianza y claridad en cada etapa.
					</p>
				</div>
			</article>
		</div>

		<!-- Actions -->
		<div class="training__actions">
			<p class="training__hint">¿No sabés por dónde empezar?</p>

			<a href="/capacitacion" class="training__cta">
				Conocé cómo podemos ayudarte
			</a>
		</div>
	</div>
</section>
