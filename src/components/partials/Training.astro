---
import "../../sass/components/partials/_training.scss";
---

<section class="training" id="capacitacion">
	<div class="wrapper">
		<!-- Header -->
		<div class="training__header">
			<span class="training__pretitle">Acompañamiento personalizado</span>

			<h2 class="training__title">
				Aprendé sobre seguridad <span class="training__accent"
					>con confianza</span
				>
			</h2>
		</div>

		<!-- Description -->
		<p class="training__description">
			Aprendé ciberseguridad con formación individual, adaptada a tus
			conocimientos y objetivos. Trabajamos sobre tus dudas y situaciones
			concretas, con explicaciones claras y sin tecnicismos innecesarios.
		</p>
		<p class="training__description">
			No necesitás ser experto en tecnología para empezar. El objetivo es que
			puedas comprender mejor los riesgos digitales y desarrollar conocimientos
			que te ayuden a desenvolverte con mayor seguridad.
		</p>

		<!-- Timeline -->
		<div class="training__timeline">
			<span class="training__timeline-line"></span>

			<!-- Plan 1 -->
			<article class="training__item">
				<div class="training__card">
					<span class="training__step">Punto de partida</span>

					<h3 class="training__item-title">Mentoría 1:1</h3>

					<p class="training__item-description">
						Una sesión individual para analizar una duda concreta, comprender
						una situación de seguridad digital o identificar cómo actuar ante un
						posible riesgo.
					</p>
				</div>
			</article>

			<!-- Dot -->
			<span class="training__dot"></span>

			<!-- Plan 2 -->
			<article class="training__item">
				<div class="training__card">
					<span class="training__step">Más elegido</span>

					<h3 class="training__item-title">Personalizado</h3>

					<p class="training__item-description">
						Un proceso de formación adaptado a tus conocimientos, necesidades y
						objetivos, con contenidos prácticos y acompañamiento individual para
						avanzar a tu ritmo.
					</p>
				</div>
			</article>

			<!-- Dot -->
			<span class="training__dot"></span>

			<!-- Plan 3 -->
			<article class="training__item">
				<div class="training__card">
					<span class="training__step">+ Extendido</span>

					<h3 class="training__item-title">Programa integral</h3>

					<p class="training__item-description">
						Un recorrido de formación más amplio para profundizar en tus
						objetivos, desarrollar conocimientos de ciberseguridad y avanzar con
						acompañamiento personalizado.
					</p>
				</div>
			</article>
		</div>

		<!-- Actions -->
		<div class="training__actions">
			<p class="training__hint">¿No sabés por dónde empezar?</p>

			<a href="/capacitacion" class="training__cta"> Ver capacitaciones </a>
		</div>
	</div>
</section>
