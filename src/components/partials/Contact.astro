---
import "../../sass/components/partials/_contact.scss";
import BackgroundSvg from "./utils/BackgroundSvg.astro";
---

<section class="section contact" id="contact">
	<div class="contact__background">
		<BackgroundSvg />
	</div>

	<div class="contact__container">
		<div class="contact__pretitle">Contacto / 04</div>

		<div class="contact__header">
			<h2 class="contact__title">
				¿Hablamos sobre <br />
				<span>tu próximo proyecto?</span>
			</h2>

			<p class="contact__description">
				Si estás buscando desarrollar una plataforma, rediseñar un producto
				digital o querés agendar una mentoría personalizada, escribime y lo
				charlamos.
			</p>
		</div>

		<a href="mailto:facundo@gqrlabs.com" class="contact__button">
			facundo@gqrlabs.com
			<span>↗</span>
		</a>
	</div>
</section>
