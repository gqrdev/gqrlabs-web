---
import "../../sass/components/partials/_contact.scss";
import {Image} from "astro:assets";
import LinkedinLogo from "../../assets/icons/linkedin-logo.png";
import MailLogo from "../../assets/icons/mail-logo.png";
---

<section class="contact" id="contact">
	<!-- Header -->
	<div class="contact__header">
		<span class="contact__pretitle">Contacto</span>
		<h2 class="contact__title">
			¿Hablamos sobre tu&nbsp;<span class="contact__accent"
				>próximo proyecto?.</span
			>
		</h2>
	</div>

	<p class="contact__description">
		Si estás buscando desarrollar una plataforma, rediseñar un producto digital
		o querés agendar una mentoría personalizada, escribime y hablamos.
	</p>

	<!-- Mail and Linkedin -->
	<div class="contact__links">
		<a href="mailto:gqrlabs@gmail.com" class="contact__button">
			Enviar un mensaje
			<Image src={MailLogo} height={28} densities={[1, 2, 3]} alt="Mail Logo" />
		</a>
		<a
			href="https://www.linkedin.com/company/gqrlabs/"
			target="_blank"
			rel="noopener noreferrer"
			class="contact__button"
		>
			Perfil profesional
			<Image
				src={LinkedinLogo}
				height={28}
				densities={[1, 2, 3]}
				alt="LinkedIn Logo"
			/>
		</a>
	</div>
</section>
