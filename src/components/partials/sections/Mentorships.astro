---
import "../../../sass/components/partials/sections/_mentorships-section.scss";
import {Image} from "astro:assets";
import CalendarIcon from "../../../assets/icons/calendar-icon.png";

const whatsappNumber = "TU_NUMERO_DE_WHATSAPP";

const whatsappLinks = {
	oneToOne: `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
		"Hola, me interesa la Mentoría 1:1 y quería consultar cómo funciona.",
	)}`,
	personalized: `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
		"Hola, me interesa el Acompañamiento personalizado y quería consultar cómo funciona.",
	)}`,
	integral: `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
		"Hola, me interesa el Programa integral y quería consultar cómo funciona.",
	)}`,
	general: `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
		"Hola, tengo algunas dudas sobre las mentorías y quería consultar qué modalidad podría ser adecuada para mí.",
	)}`,
};
---

<main>
	<section class="mentorships-section" id="mentorships">
		<div class="wrapper">
			<!-- Hero -->
			<header class="mentorships-section__header">
				<span class="mentorships-section__pretitle"> Acompañamiento </span>

				<h1 class="mentorships-section__title">
					Mentorías <span class="mentorships-section__accent">1:1</span>
				</h1>

				<p class="mentorships-section__description">
					No todas las personas necesitan aprender lo mismo ni de la misma
					manera. Por eso, las mentorías se adaptan a cada situación: desde
					resolver un problema puntual hasta aprender sobre seguridad y
					tecnología con mayor tranquilidad y confianza.
				</p>
			</header>

			<!-- Topics -->
			<div class="mentorships-section__topics">
				<div class="mentorships-section__topics-header">
					<h2 class="mentorships-section__topics-title">
						Algunos de los temas que podemos abordar.
					</h2>

					<p class="mentorships-section__topics-description">
						Vos marcás los objetivos. Nosotros construimos el contenido para
						ayudarte a alcanzarlos.
					</p>
				</div>

				<div class="mentorships-section__topics-list">
					<article class="mentorships-section__topic">
						<div class="mentorships-section__topic-body">
							<h3 class="mentorships-section__topic-title">
								Estafas y engaños
							</h3>

							<p class="mentorships-section__topic-description">
								Aprende a reconocer phishing, mensajes falsos y otras estafas
								antes de caer en ellas.
							</p>
						</div>
					</article>

					<article class="mentorships-section__topic">
						<div class="mentorships-section__topic-body">
							<h3 class="mentorships-section__topic-title">
								Privacidad y cuentas
							</h3>

							<p class="mentorships-section__topic-description">
								Protege tus datos, contraseñas y cuentas para tener mayor
								control sobre tu información.
							</p>
						</div>
					</article>

					<article class="mentorships-section__topic">
						<div class="mentorships-section__topic-body">
							<h3 class="mentorships-section__topic-title">
								Seguridad en el móvil
							</h3>

							<p class="mentorships-section__topic-description">
								Configura tu teléfono y tus aplicaciones para usarlos de forma
								más segura y tranquila.
							</p>
						</div>
					</article>
				</div>
			</div>

			<!-- Plans -->
			<div class="mentorships-section__plans-header">
				<h2 class="mentorships-section__plans-title">
					Elegí cómo querés empezar.
				</h2>

				<p class="mentorships-section__plans-description">
					Desde resolver una duda puntual hasta contar con un acompañamiento
					personalizado para mejorar tu seguridad digital.
				</p>
			</div>

			<div class="mentorships-section__plans">
				<!-- Plan 01 -->
				<article class="mentorship-plan">
					<div class="mentorship-plan__number">01</div>

					<div class="mentorship-plan__header">
						<h3 class="mentorship-plan__name">Mentoría 1:1</h3>

						<p class="mentorship-plan__description">
							Una sesión individual para resolver un problema puntual, analizar
							una situación o entender qué hacer frente a un problema de
							seguridad digital.
						</p>
					</div>

					<ul class="mentorship-plan__includes">
						<li class="mentorship-plan__item">Una sesión individual.</li>

						<li class="mentorship-plan__item">Análisis de tu situación.</li>

						<li class="mentorship-plan__item">
							Explicaciones claras, sin tecnicismos.
						</li>

						<li class="mentorship-plan__item">
							Recomendaciones prácticas para avanzar.
						</li>
					</ul>

					<a
						href={whatsappLinks.oneToOne}
						class="mentorship-plan__cta"
						target="_blank"
						rel="noopener noreferrer"
					>
						Me interesa
					</a>
				</article>

				<!-- Plan 02 -->
				<article class="mentorship-plan mentorship-plan--featured">
					<span class="mentorship-plan__badge"> Más elegido </span>

					<div class="mentorship-plan__number">02</div>

					<div class="mentorship-plan__header">
						<h3 class="mentorship-plan__name">Acompañamiento personalizado</h3>

						<p class="mentorship-plan__description">
							Un proceso diseñado alrededor de tus necesidades para aprender a
							proteger tus cuentas, dispositivos e información en situaciones
							reales de la vida cotidiana.
						</p>
					</div>

					<ul class="mentorship-plan__includes">
						<li class="mentorship-plan__item">
							Programa adaptado a tus necesidades.
						</li>

						<li class="mentorship-plan__item">4 sesiones individuales.</li>

						<li class="mentorship-plan__item">
							Ejemplos y situaciones de la vida real.
						</li>

						<li class="mentorship-plan__item">
							Material práctico para continuar aprendiendo.
						</li>

						<li class="mentorship-plan__item">
							Seguimiento durante el proceso.
						</li>
					</ul>

					<a
						href={whatsappLinks.personalized}
						class="mentorship-plan__cta"
						target="_blank"
						rel="noopener noreferrer"
					>
						Me interesa
					</a>
				</article>

				<!-- Plan 03 -->
				<article class="mentorship-plan">
					<span class="mentorship-plan__badge"> + Extendido </span>

					<div class="mentorship-plan__number">03</div>

					<div class="mentorship-plan__header">
						<h3 class="mentorship-plan__name">Programa integral</h3>

						<p class="mentorship-plan__description">
							Un acompañamiento completo para trabajar diferentes aspectos de tu
							seguridad digital y desarrollar hábitos que puedas aplicar con
							confianza en tu día a día.
						</p>
					</div>

					<ul class="mentorship-plan__includes">
						<li class="mentorship-plan__item">
							Programa diseñado según tus necesidades.
						</li>

						<li class="mentorship-plan__item">
							8 sesiones individuales o más.
						</li>

						<li class="mentorship-plan__item">
							Trabajo sobre diferentes áreas de seguridad digital.
						</li>

						<li class="mentorship-plan__item">
							Ejemplos y situaciones reales.
						</li>

						<li class="mentorship-plan__item">
							Acompañamiento durante todo el proceso.
						</li>
					</ul>

					<a
						href={whatsappLinks.integral}
						class="mentorship-plan__cta"
						target="_blank"
						rel="noopener noreferrer"
					>
						Me interesa
					</a>
				</article>
			</div>
		</div>

		<!-- CTA -->
		<div class="mentorships-section__cta">
			<div class="mentorships-section__cta-content">
				<div class="mentorships-section__cta-info">
					<p class="mentorships-section__cta-label">¿No sabés cuál elegir?</p>

					<p class="mentorships-section__cta-description">
						No hace falta que lo tengas claro desde el principio. Podemos partir
						de lo que necesitás y encontrar la modalidad que mejor se adapte a
						tu situación.
					</p>
				</div>

				<a
					href="https://calendly.com/gqrlabs/30min"
					class="mentorships-section__cta-button"
					target="_blank"
					rel="noopener noreferrer"
				>
					Hablemos<Image
						src={CalendarIcon}
						alt="Calendar Icon"
						width="30"
						height="30"
						class="mentorships-section__cta-calendar-icon"
					/>
				</a>
			</div>
		</div>

		<!-- FAQs -->
		<div class="mentorships-section__faq">
			<div class="mentorships-section__faq-header">
				<h2 class="mentorships-section__faq-title">Antes de empezar</h2>

				<p class="mentorships-section__faq-description">
					Algunas respuestas para ayudarte a entender cómo trabajamos y elegir
					el acompañamiento que mejor se adapte a vos.
				</p>
			</div>

			<div class="mentorships-section__faq-list">
				<details class="mentorships-section__faq-item">
					<summary class="mentorships-section__faq-question">
						¿Necesito tener conocimientos previos?
					</summary>

					<div class="mentorships-section__faq-answer">
						<p class="mentorships-section__faq-answer-text">
							No. Partimos de tu nivel y adaptamos cada encuentro a tus
							necesidades. No necesitás ser experto en tecnología: podemos
							empezar desde lo más básico, avanzar paso a paso o trabajar
							directamente sobre una situación que quieras entender o resolver.
						</p>
					</div>
				</details>

				<details class="mentorships-section__faq-item">
					<summary class="mentorships-section__faq-question">
						¿Qué modalidad es la adecuada para mí?
					</summary>

					<div class="mentorships-section__faq-answer">
						<p class="mentorships-section__faq-answer-text">
							Depende de lo que quieras resolver o aprender y del acompañamiento
							que estés buscando.
						</p>

						<p class="mentorships-section__faq-answer-text">
							La <strong>Mentoría 1:1</strong> es ideal si tenés una duda, una situación
							concreta o necesitás orientación sobre un tema específico.
						</p>

						<p class="mentorships-section__faq-answer-text">
							El <strong>Acompañamiento personalizado</strong> propone un proceso
							de 4 sesiones para trabajar sobre tus necesidades y mejorar tu seguridad
							digital de forma práctica.
						</p>

						<p class="mentorships-section__faq-answer-text">
							El <strong>Programa integral</strong> es un proceso de 8 sesiones o
							más para trabajar diferentes aspectos de tu seguridad digital con un
							acomp añamiento más completo.
						</p>
					</div>
				</details>

				<details class="mentorships-section__faq-item">
					<summary class="mentorships-section__faq-question">
						¿Qué pasa si no sé exactamente qué necesito?
					</summary>

					<div class="mentorships-section__faq-answer">
						<p class="mentorships-section__faq-answer-text">
							No hace falta que tengas todo definido antes de empezar. Podés
							contarnos qué te preocupa, qué te gustaría aprender o qué
							situación querés resolver, y te ayudamos a encontrar el camino que
							tenga más sentido para vos.
						</p>
					</div>
				</details>

				<details class="mentorships-section__faq-item">
					<summary class="mentorships-section__faq-question">
						¿Puedo empezar con una Mentoría 1:1 y después continuar?
					</summary>

					<div class="mentorships-section__faq-answer">
						<p class="mentorships-section__faq-answer-text">
							Sí. Podés empezar con una Mentoría 1:1 y, si después querés seguir
							trabajando sobre otros temas, avanzar hacia un acomp añamiento más
							completo. La modalidad puede adaptarse a tus necesidades en cada
							momento.
						</p>
					</div>
				</details>
			</div>

			<!-- Final CTA -->
			<div class="mentorships-section__faq-cta">
				<div class="mentorships-section__faq-cta-content">
					<div class="mentorships-section__faq-cta-info">
						<p class="mentorships-section__faq-cta-title">
							¿Todavía tenés dudas?
						</p>

						<p class="mentorships-section__faq-cta-description">
							Contanos qué necesitás y te ayudamos a encontrar la modalidad que
							tenga más sentido para vos.
						</p>
					</div>

					<a
						href="https://calendly.com/gqrlabs/30min"
						class="mentorships-section__cta-button"
						target="_blank"
						rel="noopener noreferrer"
					>
						Hablemos<Image
							src={CalendarIcon}
							alt="Calendar Icon"
							width="30"
							height="30"
							class="mentorships-section__faq-cta-calendar-icon"
						/>
					</a>
				</div>
			</div>
		</div>
	</section>
</main>
