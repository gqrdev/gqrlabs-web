---
import "../../../sass/components/partials/sections/_training-section.scss";
import {Image} from "astro:assets";
import CalendarIcon from "../../../assets/icons/calendar-icon.png";
import ChampionIcon from "../../../assets/icons/champion.png";

const mailContact = {
	oneToOne: `mailto:gqrlabs@gmail.com?subject=${encodeURIComponent(
		"Consulta sobre Mentoría 1:1",
	)}&body=${encodeURIComponent(
		"Hola, me interesa la Mentoría 1:1 y quería consultar cómo funciona.",
	)}`,
	personalized: `mailto:gqrlabs@gmail.com?subject=${encodeURIComponent(
		"Consulta sobre Acompañamiento personalizado",
	)}&body=${encodeURIComponent(
		"Hola, me interesa el Acompañamiento personalizado y quería consultar cómo funciona.",
	)}`,
	integral: `mailto:gqrlabs@gmail.com?subject=${encodeURIComponent(
		"Consulta sobre Programa integral",
	)}&body=${encodeURIComponent(
		"Hola, me interesa el Programa integral y quería consultar cómo funciona.",
	)}`,
	general: `mailto:gqrlabs@gmail.com?subject=${encodeURIComponent(
		"Consulta general sobre mentorías",
	)}&body=${encodeURIComponent(
		"Hola, tengo algunas dudas sobre las mentorías y quería consultar qué modalidad podría ser adecuada para mí.",
	)}`,
};
---


<main>
	<section class="mentorships-section" id="mentorships">
		<div class="wrapper">
			<!-- Hero -->
			<header class="mentorships-section__header">
				<span class="mentorships-section__pretitle">
					Formación en ciberseguridad
				</span>

				<h1 class="mentorships-section__title">
					Capacitación <span class="mentorships-section__accent"
						>personalizada</span
					>
				</h1>

				<p class="mentorships-section__description">
					Aprendé ciberseguridad con formación individual, adaptada a tus
					conocimientos, necesidades y objetivos. Trabajamos sobre tus dudas
					y situaciones concretas, con explicaciones claras y ejemplos
					prácticos. Tanto si querés resolver una duda puntual como si
					buscás desarrollar nuevos conocimientos, te acompañamos para que
					aprendas a tu ritmo, sin tecnicismos.
				</p>
			</header>

			<!-- Topics -->
			<div class="mentorships-section__topics">
				<div class="mentorships-section__topics-header">
					<h2 class="mentorships-section__topics-title">
						¿Qué podés aprender sobre ciberseguridad?
					</h2>

					<p class="mentorships-section__topics-description">
						Definimos los contenidos según tus objetivos, tus conocimientos
						y las situaciones que querés aprender a resolver.
					</p>
				</div>

				<div class="mentorships-section__topics-list">
					<article class="mentorships-section__topic">
						<div class="mentorships-section__topic-body">
							<h3 class="mentorships-section__topic-title">
								Cultura y conciencia digital
							</h3>

							<p class="mentorships-section__topic-description">
								Aprendé a reconocer riesgos digitales y desarrollá hábitos
								que te ayuden a navegar, comunicarte y utilizar herramientas
								digitales con mayor seguridad.
							</p>
						</div>
					</article>

					<article class="mentorships-section__topic">
						<div class="mentorships-section__topic-body">
							<h3 class="mentorships-section__topic-title">
								Seguridad y privacidad
							</h3>

							<p class="mentorships-section__topic-description">
								Conocé cómo proteger tus cuentas, dispositivos e información
								personal, reconocer posibles engaños y aplicar buenas
								prácticas de seguridad digital en tu día a día.
							</p>
						</div>
					</article>

					<article class="mentorships-section__topic">
						<div class="mentorships-section__topic-body">
							<h3 class="mentorships-section__topic-title">
								Tecnología aplicada
							</h3>

							<p class="mentorships-section__topic-description">
								Comprendé mejor las herramientas y tecnologías que utilizás,
							y aprendé a aprovecharlas de forma práctica, consciente y segura.
							</p>
						</div>
					</article>
				</div>
			</div>

			<!-- Plans -->
			<div class="mentorships-section__plans-header">
				<h2 class="mentorships-section__plans-title">
					Elegí tu modalidad de formación en ciberseguridad
				</h2>

				<p class="mentorships-section__plans-description">
					Desde una mentoría individual para resolver una duda concreta
					hasta un programa de formación con acompañamiento personalizado.
					Elegí la modalidad que mejor se adapte a tus objetivos.
				</p>
			</div>

			<div class="mentorships-section__plans">
				<!-- Plan 01 -->
				<article class="mentorship-plan">
					<div class="mentorship-plan__number">01</div>

					<div class="mentorship-plan__header">
						<h3 class="mentorship-plan__name">Mentoría 1:1</h3>

						<p class="mentorship-plan__description">
							Una sesión individual de ciberseguridad para abordar una
							necesidad concreta, resolver dudas y comprender cómo actuar
							ante una situación de seguridad digital. Trabajamos sobre
							tu caso con explicaciones claras y recomendaciones prácticas.
						</p>
					</div>

					<ul class="mentorship-plan__includes">
						<li class="mentorship-plan__item">
							Una sesión individual
						</li>

						<li class="mentorship-plan__item">
							Análisis de tu situación
						</li>

						<li class="mentorship-plan__item">
							Sin tecnicismos innecesarios
						</li>

						<li class="mentorship-plan__item">
							Ejemplos y situaciones de la vida real
						</li>

						<li class="mentorship-plan__item">
							Recomendaciones prácticas para avanzar
						</li>
					</ul>

					<a
						href={mailContact.oneToOne}
						class="mentorship-plan__cta"
						target="_blank"
						rel="noopener noreferrer"
					>
						Me interesa
					</a>
				</article>

				<!-- Plan 02 -->
				<article class="mentorship-plan mentorship-plan--featured">
					<span class="mentorship-plan__badge">
						Más elegido
						<Image src={ChampionIcon} alt="Champion Icon" width={30} height={30} />
					</span>

					<div class="mentorship-plan__number">02</div>

					<div class="mentorship-plan__header">
						<h3 class="mentorship-plan__name">
							Personalizado
						</h3>

						<p class="mentorship-plan__description">
							Un proceso de formación en ciberseguridad de cuatro sesiones
							individuales, adaptado a tus conocimientos, necesidades y
							objetivos. Aprendé con ejemplos prácticos y acompañamiento
							directo para avanzar a tu propio ritmo.
						</p>
					</div>

					<ul class="mentorship-plan__includes">
						<li class="mentorship-plan__item">
							<strong>4 sesiones individuales</strong>
						</li>
						
						<li class="mentorship-plan__item">
							<strong>Contenido adaptado a tus necesidades</strong>
						</li>

						<li class="mentorship-plan__item">
							Acompañamiento durante el proceso
						</li>

						<li class="mentorship-plan__item">
							Ejemplos y situaciones de la vida real
						</li>

						<li class="mentorship-plan__item">
							Material práctico de aprendizaje
						</li>
					</ul>

					<a
						href={mailContact.personalized}
						class="mentorship-plan__cta"
						target="_blank"
						rel="noopener noreferrer"
					>
						Me interesa
					</a>
				</article>

				<!-- Plan 03 -->
				<article class="mentorship-plan">
					<span class="mentorship-plan__badge">
						Programa extendido
					</span>

					<div class="mentorship-plan__number">03</div>

					<div class="mentorship-plan__header">
						<h3 class="mentorship-plan__name">Programa integral</h3>

						<p class="mentorship-plan__description">
							Un programa de formación en ciberseguridad de ocho sesiones
							individuales para profundizar en tus objetivos, desarrollar
							conocimientos y adquirir herramientas prácticas para
							desenvolverte con mayor seguridad y autonomía.
						</p>
					</div>

					<ul class="mentorship-plan__includes">
						<li class="mentorship-plan__item">
							<strong>8 sesiones individuales</strong>
						</li>
						
						<li class="mentorship-plan__item">
							<strong>Contenido adaptado a tus objetivos</strong>
						</li>

						<li class="mentorship-plan__item">
							Acompañamiento durante el proceso
						</li>

						<li class="mentorship-plan__item">
							Ejemplos y situaciones de la vida real
						</li>

						<li class="mentorship-plan__item">
							Material práctico de aprendizaje
						</li>
					</ul>

					<a
						href={mailContact.integral}
						class="mentorship-plan__cta"
						target="_blank"
						rel="noopener noreferrer"
					>
						Me interesa
					</a>
				</article>
			</div>
		</div>

		<!-- CTA -->
		<div class="mentorships-section__cta">
			<div class="mentorships-section__cta-content">
				<div class="mentorships-section__cta-info">
					<p class="mentorships-section__cta-label">
						¿No sabés qué formación elegir?
					</p>

					<p class="mentorships-section__cta-description">
						No necesitás tener todos tus objetivos definidos desde el
						principio. Contanos qué te gustaría aprender o qué situación
						querés resolver y te ayudamos a encontrar la modalidad más
						adecuada para vos.
					</p>
				</div>

				<a
					href="https://calendly.com/gqrlabs/hablemos"
					class="mentorships-section__cta-button"
					target="_blank"
					rel="noopener noreferrer"
				>
					Hablemos<Image
						src={CalendarIcon}
						alt="Agendar una conversación"
						width="30"
						height="30"
					/>
				</a>
			</div>
		</div>

		<!-- FAQs -->
		<div class="mentorships-section__faq">
			<div class="mentorships-section__faq-header">
				<h2 class="mentorships-section__faq-title">
					Preguntas frecuentes sobre la formación en ciberseguridad
				</h2>

				<p class="mentorships-section__faq-description">
					Conocé cómo funciona la capacitación personalizada y encontrá
					respuestas para elegir la modalidad que mejor se adapte a vos.
				</p>
			</div>

			<div class="mentorships-section__faq-list">
				<details class="mentorships-section__faq-item">
					<summary class="mentorships-section__faq-question">
						¿Necesito tener conocimientos previos de ciberseguridad?
					</summary>

					<div class="mentorships-section__faq-answer">
						<p class="mentorships-section__faq-answer-text">
							No. La formación se adapta a tus conocimientos y necesidades.
							No necesitás ser experto en tecnología: podemos empezar por
							los conceptos básicos, avanzar paso a paso o trabajar
							directamente sobre una situación que quieras comprender
							o resolver.
						</p>
					</div>
				</details>

				<details class="mentorships-section__faq-item">
					<summary class="mentorships-section__faq-question">
						¿Qué modalidad de capacitación es adecuada para mí?
					</summary>

					<div class="mentorships-section__faq-answer">
						<p class="mentorships-section__faq-answer-text">
							Depende de lo que quieras aprender, la situación que necesites
							resolver y el nivel de acompañamiento que estés buscando.
						</p>

						<p class="mentorships-section__faq-answer-text">
							La <strong>Mentoría 1:1</strong> es adecuada si tenés una
							duda concreta, necesitás orientación o querés trabajar sobre
							un tema específico en una sesión individual.
						</p>

						<p class="mentorships-section__faq-answer-text">
							El <strong>Acompañamiento personalizado</strong> consiste
							en cuatro sesiones individuales para trabajar sobre tus
							necesidades y desarrollar conocimientos prácticos de
							seguridad digital.
						</p>

						<p class="mentorships-section__faq-answer-text">
							El <strong>Programa integral</strong> ofrece ocho sesiones
							individuales para profundizar en tus objetivos mediante un
							proceso de formación más amplio y personalizado.
						</p>
					</div>
				</details>

				<details class="mentorships-section__faq-item">
					<summary class="mentorships-section__faq-question">
						¿Qué pasa si no sé exactamente qué necesito aprender?
					</summary>

					<div class="mentorships-section__faq-answer">
						<p class="mentorships-section__faq-answer-text">
							No hace falta que tengas todo definido antes de empezar.
							Podés contarnos qué te preocupa, qué te gustaría aprender
							o qué situación querés resolver. A partir de eso, podemos
							conversar sobre la modalidad que mejor se adapte a tus
							necesidades.
						</p>
					</div>
				</details>

				<details class="mentorships-section__faq-item">
					<summary class="mentorships-section__faq-question">
						¿Puedo empezar con una Mentoría 1:1 y después continuar?
					</summary>

					<div class="mentorships-section__faq-answer">
						<p class="mentorships-section__faq-answer-text">
							Sí. Podés empezar con una Mentoría 1:1 y, si después querés
							seguir aprendiendo, continuar con un acompañamiento
							personalizado o un programa integral. La modalidad se puede
							elegir según tus objetivos y las necesidades que tengas
							en cada momento.
						</p>
					</div>
				</details>
			</div>

			<!-- Final CTA -->
			<div class="mentorships-section__faq-cta">
				<div class="mentorships-section__faq-cta-content">
					<div class="mentorships-section__faq-cta-info">
						<p class="mentorships-section__faq-cta-title">
							¿Tenés dudas sobre la capacitación?
						</p>

						<p class="mentorships-section__faq-cta-description">
							Contanos qué querés aprender y te ayudamos a encontrar
							la modalidad de formación en ciberseguridad más adecuada
							para tus objetivos.
						</p>
					</div>

					<a
						href="https://calendly.com/gqrlabs/hablemos"
						class="mentorships-section__cta-button"
						target="_blank"
						rel="noopener noreferrer"
					>
						Hablemos<Image
							src={CalendarIcon}
							alt="Agendar una conversación"
							width="30"
							height="30"
							class="mentorships-section__faq-cta-calendar-icon"
						/>
					</a>
				</div>
			</div>
		</div>
	</section>
</main>
