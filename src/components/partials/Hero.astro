---
import "../../sass/components/partials/_hero.scss";
import BackgroundSvg from "./utils/BackgroundSvg.astro";
---

<section class="hero">
	<div class="hero__background" aria-hidden="true">
		<BackgroundSvg />
	</div>

	<div class="hero__content">
		<div class="hero__pretitle">Inicio</div>

		<h1 class="hero__title">
			Desarrollo de Software
			<span class="hero__accent"> Lorem ipsum </span>
		</h1>

		<p class="hero__description">
			Lorem ipsum dolor sit amet, consectetur adipiscing elit... Lorem ipsum
			dolor sit amet, consectetur adipiscing elit... Lorem ipsum dolor sit amet,
			consectetur adipiscing elit... Lorem ipsum dolor sit amet, consectetur
			adipiscing elit... Lorem ipsum dolor sit amet, consectetur adipiscing
			elit...
		</p>

		<div class="hero__actions">
			<a href="#contact" class="hero__button">Hablemos<span>↗</span></a>
			<a href="#projects" class="hero__link hero__link--secondary"
				>Ver proyectos</a
			>
		</div>
	</div>
</section>
