---
import "../../sass/components/partials/_hero.scss";
import HeroVideoDesktop from "../../assets/videos/home-video.mp4";
import HeroVideoMobile from "../../assets/videos/home-video-mobile.mp4";
---

<section class="hero">
	<!-- @ts-ignore -->
	<video
		class="hero__background-video"
		autoplay
		muted
		loop
		playsinline
		poster="/images/home-video-poster.jpg"
	>
		<source
			src={HeroVideoDesktop}
			type="video/mp4"
			media="(min-width: 768px)"
		/>
		<source src={HeroVideoMobile} type="video/mp4" />
	</video>
	<div class="hero__content">
		<!-- Header -->
		<div class="hero__header">
			<div class="hero__pretitle">Inicio</div>
			<h1 class="hero__title">
				Software, inteligencia artificial y <span class="hero__accent"
					>Ciberseguridad</span
				>
			</h1>
		</div>

		<div class="hero__copy">
			<!-- Description -->
			<p class="hero__description">
				En GQR Labs desarrollamos software a medida y soluciones tecnológicas
				adaptadas a las necesidades de cada negocio. Trabajamos con aplicaciones
				web, sistemas internos, automatización, inteligencia artificial e
				infraestructura cloud con AWS.
			</p>
			<p class="hero__description">
				También ofrecemos formación personalizada en ciberseguridad para quienes
				quieren aprender a protegerse en el entorno digital, comprender mejor la
				tecnología y desarrollar nuevos conocimientos.
			</p>

			<div class="hero__actions">
				<a href="#software" class="hero__button">
					Conocé cómo podemos ayudarte
				</a>
			</div>
			<span class="hero__place">
				Tecnología, claridad y acompañamiento directo en cada etapa.
			</span>
		</div>

		<div class="hero__terminal" aria-hidden="true">
			<div class="hero__terminal-titlebar">
				gqr-labs // software &amp; cybersecurity
			</div>
			<div class="hero__terminal-screen">
				<div class="hero__terminal-line">
					<span class="hero__terminal-prompt">gqr</span>:~$
					<span class="hero__terminal-command">start project</span>
				</div>
				<div class="hero__terminal-line">
					<span class="hero__terminal-label hero__terminal-label--process"
						>[INIT]</span
					>
					GQR Labs — soluciones tecnológicas
				</div>
				<div class="hero__terminal-line">
					<span class="hero__terminal-label hero__terminal-label--process"
						>[ANALYSIS]</span
					>
					Analizando necesidades y objetivos
				</div>
				<div class="hero__terminal-line">
					<span class="hero__terminal-label hero__terminal-label--info"
						>[PLANNING]</span
					>
					Diseñando una solución a medida
				</div>
				<div class="hero__terminal-line">
					<span class="hero__terminal-label hero__terminal-label--process"
						>[SOFTWARE]</span
					>
					Sistemas internos y aplicaciones web
				</div>
				<div class="hero__terminal-line">
					<span class="hero__terminal-label hero__terminal-label--process"
						>[INFRA]</span
					>
					Configurando infraestructura segura
				</div>
				<div class="hero__terminal-line">
					<span class="hero__terminal-label hero__terminal-label--warning"
						>[SECURITY]</span
					>
					Priorizando seguridad y buenas prácticas
				</div>
				<div class="hero__terminal-line">
					<span class="hero__terminal-label hero__terminal-label--success"
						>[BUILD]</span
					>
					Desarrollando la solución
				</div>
				<div class="hero__terminal-line">
					<span class="hero__terminal-label hero__terminal-label--success"
						>[DELIVERY]</span
					>
					Implementación y acompañamiento
				</div>
				<div class="hero__terminal-line">
					<span class="hero__terminal-label hero__terminal-label--info"
						>[TRAINING]</span
					>
					Capacitación en seguridad digital
				</div>
				<div class="hero__terminal-line">
					<span class="hero__terminal-label hero__terminal-label--success"
						>[STATUS]</span
					>
					Proyecto listo para evolucionar
				</div>
				<div class="hero__terminal-line">
					<span class="hero__terminal-prompt">gqr</span>:~$
					<span class="hero__terminal-cursor"></span>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const terminal = document.querySelector(".hero__terminal");

	if (terminal) {
		const lines = Array.from(terminal.querySelectorAll(".hero__terminal-line"));
		let timer: ReturnType<typeof setTimeout> | undefined;
		let index = 0;
		let cycleStartedAt = 0;

		const schedule = (callback: () => void, delay: number) => {
			if (timer) clearTimeout(timer);
			timer = setTimeout(callback, delay);
		};

		const startCycle = () => {
			lines.forEach((line) =>
				line.classList.remove("hero__terminal-line--visible"),
			);
			index = 0;
			cycleStartedAt = Date.now();
			printNextLine();
		};

		const printNextLine = () => {
			if (index >= lines.length) {
				schedule(
					startCycle,
					Math.max(0, 11000 - (Date.now() - cycleStartedAt)),
				);
				return;
			}

			lines[index].classList.add("hero__terminal-line--visible");
			index += 1;
			schedule(printNextLine, 1000);
		};

		terminal.classList.add("hero__terminal--animated");
		startCycle();
		document.addEventListener(
			"astro:before-swap",
			() => {
				if (timer) clearTimeout(timer);
			},
			{once: true},
		);
	}
</script>
