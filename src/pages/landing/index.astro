---
import LandingVideoMobile from "../../assets/videos/landing-video-mobile.mp4";
import LandingVideoDesktop from "../../assets/videos/landing-video.mp4";

const mailContact = {
	oneToOne: `mailto:gqrlabs@gmail.com?subject=${encodeURIComponent(
		"Consulta sobre Mentoría 1:1",
	)}&body=${encodeURIComponent(
		"Hola, me interesa la Mentoría 1:1 y quería consultar cómo funciona.",
	)}`,
	personalized: `mailto:gqrlabs@gmail.com?subject=${encodeURIComponent(
		"Consulta sobre Acompañamiento personalizado",
	)}&body=${encodeURIComponent(
		"Hola, me interesa el Acompañamiento personalizado y quería consultar cómo funciona.",
	)}`,
	integral: `mailto:gqrlabs@gmail.com?subject=${encodeURIComponent(
		"Consulta sobre Programa integral",
	)}&body=${encodeURIComponent(
		"Hola, me interesa el Programa integral y quería consultar cómo funciona.",
	)}`,
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="googlebot" content="noindex, nofollow" />
		<title>GQR Labs | Protección Digital</title>

		<meta
			name="description"
			content="Desarrollo de software, ciberseguridad y soluciones tecnológicas a medida. Consultoría y mentorías para potenciar proyectos y equipos desde Uruguay."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Roboto+Condensed:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header>
			<div class="container nav">
				<a href="https://gqrlabs.com/" class="logo">
					GQR<span>Labs</span>
				</a>

				<nav class="nav-links">
					<a href="#como-funciona">Cómo funciona</a>
					<a href="#planes">Opciones</a>
					<a href="#preguntas">Preguntas</a>
				</nav>

				<a
					class="nav-cta"
					target="_blank"
					rel="noopener"
					href="https://wa.me/598XXXXXXXX?text=Hola%2C%20vi%20la%20p%C3%A1gina%20de%20GQR%20Labs%20y%20quiero%20hablar%20con%20una%20persona."
				>
					Hablar con una persona
				</a>
			</div>
		</header>
		<main>
			<section class="hero">
				<div class="container hero-grid">
					<div class="hero-grid__content">
						<div class="eyebrow">Capacitación personalizada</div>

						<h1>
							Tu seguridad digital. <span>Explicada por una persona.</span>
						</h1>

						<p class="hero-text">
							No necesitás saber de informática para estar más seguro.
							<strong> Hablá con una persona real de GQR Labs </strong>
							y encontrá la forma de aprender y protegerte que mejor se adapte a vos.
						</p>
					</div>

					<div class="person-points">
						<div class="point">👂 <span>Primero te escuchamos</span></div>
						<div class="point">🧭 <span>Entendemos tu situación</span></div>
						<div class="point">
							🛡️ <span>Te explicamos qué podés hacer</span>
						</div>
						<div class="point">🤝 <span>Te acompañamos paso a paso</span></div>
					</div>

					<a
						class="btn btn-primary hero-grid__cta"
						rel="noopener"
						href="https://wa.me/598XXXXXXXX?text=Hola%2C%20vi%20la%20p%C3%A1gina%20de%20GQR%20Labs%20y%20quiero%20hablar%20con%20una%20persona%20sobre%20mi%20seguridad%20digital."
						>Me interesa
					</a>

					<div class="trust">
						<span>Sin tecnicismos</span>
						<span>Atención 1:1</span>
						<span>Adaptado a vos</span>
					</div>
				</div>
			</section>
			<section>
				<div class="container">
					<div class="human-box">
						<div class="human-box__content">
							<div class="kicker">Una idea sencilla</div>
							<h2>No necesitás entender de tecnología.</h2>
							<p>
								Necesitás tener a quién preguntarle cuando algo te genera dudas.
							</p>
							<p>
								Un mensaje extraño, una llamada inesperada, una cuenta que
								querés proteger o simplemente la sensación de que no sabés por
								dónde empezar.
							</p>
							<div class="quote">
								“No sé si esto es seguro.”
								<br />
								<span class="quote__accent">Preguntá antes de hacer clic.</span>
							</div>
						</div>

						<aside class="person-card" aria-labelledby="person-card-title">
							<div class="photo">👤</div>
							<h3 id="person-card-title">Hay una persona del otro lado.</h3>
							<div class="role">GQR Labs · Protección Digital</div>
							<p>
								Podés contarme qué te preocupa con tus propias palabras. No
								necesitás saber de tecnología para empezar.
							</p>
						</aside>
					</div>
				</div>
			</section>
			<section>
				<div class="container">
					<div class="section-head">
						<div class="kicker">Situaciones reales</div>

						<h2 class="section-title">¿Te pasó alguna de estas cosas?</h2>

						<p class="section-intro">
							No hace falta esperar a tener un problema. Podemos trabajar sobre
							tus dudas y ayudarte a desarrollar mejores hábitos de seguridad.
						</p>
					</div>

					<div class="problem-grid">
						<div class="card">
							<div class="icon">📱</div>
							<h3>“Me llegó un mensaje raro.”</h3>
							<p>
								Aprendé a reconocer señales de alerta antes de responder o abrir
								un enlace.
							</p>
						</div>

						<div class="card">
							<div class="icon">🔐</div>
							<h3>“Tengo demasiadas contraseñas.”</h3>
							<p>
								Aprendé formas más seguras y ordenadas de proteger tus cuentas.
							</p>
						</div>

						<div class="card">
							<div class="icon">💳</div>
							<h3>“¿Esto será una estafa?”</h3>
							<p>
								Trabajamos sobre las señales que pueden ayudarte a detectar
								engaños.
							</p>
						</div>

						<div class="card">
							<div class="icon">💬</div>
							<h3>“Quiero proteger mi WhatsApp.”</h3>
							<p>
								Entendé los principales riesgos y hábitos que ayudan a proteger
								tus cuentas.
							</p>
						</div>

						<div class="card">
							<div class="icon">📧</div>
							<h3>“No sé si este correo es real.”</h3>
							<p>
								Aprendé qué señales mirar para tomar decisiones con mayor
								tranquilidad.
							</p>
						</div>

						<div class="card">
							<div class="icon">🤔</div>
							<h3>“No sé por dónde empezar.”</h3>
							<p>
								No pasa nada. Podemos empezar justamente por entender qué
								necesitás.
							</p>
						</div>
					</div>
				</div>
			</section>
			<section id="como-funciona">
				<div class="container">
					<div class="section-head">
						<div class="kicker">Así funciona</div>

						<h2 class="section-title">Empezamos hablando.</h2>

						<p class="section-intro">
							No necesitás saber qué capacitación comprar. Primero conocemos tu
							situación.
						</p>
					</div>

					<div class="steps">
						<div class="card">
							<div class="step-number">1</div>

							<h3>Nos escribís</h3>

							<p>Mandanos un WhatsApp y contanos qué te preocupa.</p>
						</div>

						<div class="card">
							<div class="step-number">2</div>

							<h3>Te escuchamos</h3>

							<p>Conversamos brevemente para entender qué necesitás.</p>
						</div>

						<div class="card">
							<div class="step-number">3</div>

							<h3>Te orientamos</h3>

							<p>
								Te recomendamos la modalidad que tenga más sentido para vos.
							</p>
						</div>

						<div class="card">
							<div class="step-number">4</div>

							<h3>Trabajamos juntos</h3>

							<p>Coordinamos y empezamos paso a paso.</p>
						</div>
					</div>

					<div class="process-video">
						<header class="process-video__header">
							<p class="process-video__eyebrow">El proceso, en la práctica</p>

							<h3 class="process-video__title" id="process-video-title">
								Así se ve el acompañamiento.
							</h3>

							<p class="process-video__description">
								Una muestra de cómo conversamos sobre tus dudas, entendemos tu
								situación y definimos juntos pasos concretos para que puedas
								avanzar con más seguridad.
							</p>
						</header>

						<video
							class="process-video__frame"
							autoplay
							muted
							loop
							playsinline
							poster="/images/landing-video-poster.jpg"
							aria-hidden="true"
						>
							<source
								src={LandingVideoDesktop}
								type="video/mp4"
								media="(min-width: 768px)"
							/>
							<source src={LandingVideoMobile} type="video/mp4" />
						</video>

						<p class="process-video__caption">
							Ejemplo del proceso de acompañamiento · GQR Labs
						</p>
					</div>
				</div>
			</section>
			<section class="plans" id="planes">
				<div class="container">
					<div class="plans-head">
						<div class="kicker">Acompañamiento</div>

						<h2 class="section-title">Elegí cómo querés empezar.</h2>

						<p class="section-intro">
							Desde resolver una duda puntual hasta contar con un acompañamiento
							personalizado para mejorar tu seguridad digital.
						</p>
					</div>

					<div class="plan-grid">
						<article class="plan">
							<div class="plan-number">01</div>

							<h3>Mentoría 1:1</h3>

							<p>
								Una sesión personalizada para abordar una necesidad concreta,
								resolver dudas y encontrar respuestas claras para avanzar con
								mayor seguridad y confianza en el día a día.
							</p>

							<ul>
								<li>Una sesión individual.</li>
								<li>Análisis de tu situación.</li>
								<li>Explicaciones claras, sin tecnicismos.</li>
								<li>Ejemplos y situaciones de la vida real.</li>
								<li>Recomendaciones prácticas para avanzar.</li>
							</ul>

							<a
								class="btn btn-primary"
								target="_blank"
								rel="noopener"
								href={mailContact.oneToOne}
							>
								Me interesa
							</a>
						</article>

						<article class="plan featured">
							<div class="badge">Más elegido</div>

							<div class="plan-number">02</div>

							<h3>Acompañamiento personalizado</h3>

							<p>
								Un proceso diseñado a tu medida, adaptado a tus necesidades,
								conocimientos y objetivos, con contenidos prácticos para
								aprender de forma clara, flexible y con confianza a tu propio
								ritmo.
							</p>

							<ul>
								<li>
									<strong>Programa diseñado según tus necesidades.</strong>
								</li>
								<li><strong>4 sesiones individuales.</strong></li>
								<li>Acompañamiento durante todo el proceso.</li>
								<li>Ejemplos y situaciones de la vida real.</li>
								<li>Material práctico para continuar aprendiendo.</li>
							</ul>

							<a
								class="btn btn-primary"
								target="_blank"
								rel="noopener"
								href={mailContact.personalized}
							>
								Me interesa
							</a>
						</article>

						<article class="plan">
							<div class="badge">+ Extendido</div>

							<div class="plan-number">03</div>

							<h3>Programa integral</h3>

							<p>
								Un proceso más completo para profundizar en tus objetivos,
								desarrollar nuevas habilidades y avanzar con mayor autonomía,
								confianza y claridad en cada etapa de tu aprendizaje.
							</p>

							<ul>
								<li>
									<strong>Programa diseñado según tus necesidades.</strong>
								</li>
								<li><strong>8 sesiones individuales.</strong></li>
								<li>Acompañamiento durante todo el proceso.</li>
								<li>Ejemplos y situaciones de la vida real.</li>
								<li>Material práctico para continuar aprendiendo.</li>
							</ul>

							<a
								class="btn btn-secondary"
								target="_blank"
								rel="noopener"
								href={mailContact.integral}
							>
								Me interesa
							</a>
						</article>
					</div>
				</div>
			</section>
			<section class="vip">
				<div class="container">
					<div class="vip-box">
						<div>
							<div class="kicker">Para quienes buscan algo más</div>

							<h2>No necesitás resolver todo solo.</h2>

							<p>
								El acompañamiento personal está pensado para quienes prefieren
								tener una persona de confianza a quien consultar y con quien
								trabajar de forma continua.
							</p>

							<a
								class="btn btn-primary"
								target="_blank"
								rel="noopener"
								href="https://wa.me/598XXXXXXXX?text=Hola%2C%20quiero%20conocer%20el%20acompa%C3%B1amiento%20personal%20de%20GQR%20Labs."
							>
								💬 Quiero conocerlo
							</a>
						</div>

						<ul class="vip-list">
							<li>Seguimiento personalizado</li>
							<li>Sesiones periódicas</li>
							<li>Capacitación adaptada</li>
							<li>Orientación ante nuevas dudas</li>
							<li>Relación de largo plazo</li>
							<li>Una persona de confianza</li>
						</ul>
					</div>
				</div>
			</section>
			<section id="preguntas">
				<div class="container">
					<div class="section-head">
						<div class="kicker">Preguntas frecuentes</div>

						<h2 class="section-title">No necesitás saber de tecnología.</h2>
					</div>

					<div class="faq">
						<details>
							<summary> ¿Voy a hablar con una persona real? </summary>
							<p>
								Sí. La propuesta está basada en atención y capacitación
								personalizada.
							</p>
						</details>

						<details>
							<summary> ¿Necesito conocimientos técnicos? </summary>
							<p>
								No. Trabajamos con lenguaje claro y adaptamos la explicación a
								tu nivel.
							</p>
						</details>

						<details>
							<summary> ¿Cómo sé qué plan necesito? </summary>
							<p>
								No necesitás decidirlo solo. Podés escribirnos, contarnos qué te
								preocupa y te orientamos.
							</p>
						</details>

						<details>
							<summary> ¿Puedo empezar solamente con una sesión? </summary>
							<p>
								Sí. La Mentoría 1:1 está pensada precisamente para empezar de
								forma sencilla y trabajar una necesidad concreta.
							</p>
						</details>

						<details>
							<summary> ¿La conversación inicial tiene costo? </summary>
							<p>
								La conversación inicial de orientación de hasta 15 minutos puede
								ofrecerse sin costo para quienes estén evaluando una
								capacitación personalizada o un acompañamiento.
							</p>
						</details>

						<details>
							<summary>
								¿La capacitación garantiza que nunca voy a sufrir una estafa?
							</summary>
							<p>
								No. Ninguna capacitación puede garantizar eso. El objetivo es
								ayudarte a reconocer riesgos, comprender señales de alerta y
								desarrollar mejores hábitos de seguridad.
							</p>
						</details>
					</div>
				</div>
			</section>
			<section class="cta">
				<div class="container">
					<div class="kicker">Empezá por una pregunta</div>

					<h2>No necesitás saber por dónde empezar.</h2>

					<p>
						Contanos qué te preocupa y hablá con una persona real de GQR Labs.
					</p>

					<a
						class="btn btn-primary"
						target="_blank"
						rel="noopener"
						href="https://wa.me/598XXXXXXXX?text=Hola%2C%20vi%20la%20p%C3%A1gina%20de%20GQR%20Labs%20y%20quiero%20hablar%20con%20una%20persona."
					>
						💬 Hablar con una persona
					</a>
				</div>
			</section>
		</main>
		<a
			class="float-whatsapp"
			target="_blank"
			rel="noopener"
			aria-label="WhatsApp"
			href="https://wa.me/598XXXXXXXX?text=Hola%2C%20quiero%20hablar%20con%20una%20persona%20de%20GQR%20Labs."
		>
			💬
		</a>
		<footer class="footer">
			<div class="container footer-inner">
				<div>
					<strong class="footer__brand">
						GQR<span class="footer__accent">Labs</span>
					</strong>
					— Protección digital personalizada.
				</div>

				<div>© 2026 GQR Labs</div>
			</div>
		</footer>
	</body>
</html>

<style lang="scss">
	@use "sass:color";
	@use "../../sass/base/mixins" as mixin;

	$bg: #111a20;
	$bg2: #19252d;
	$card: #22343e;
	$primary: #c6a15b;
	$primary2: #d8b978;
	$blue: #7f9baa;
	$white: #f5f1e8;
	$text: #d9d5cc;
	$muted: #a5aaa9;
	$border: color.scale($white, $alpha: -88%);
	$green: #4f9f76;
	$max: 1180px;
	$radius: 22px;
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}
	html {
		scroll-behavior: smooth;
	}
	body {
		font-family:
			"Roboto Condensed",
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			Arial,
			sans-serif;
		background:
			radial-gradient(
				circle at 85% 0%,
				color.scale($primary, $alpha: -88%),
				transparent 28%
			),
			radial-gradient(
				circle at 0% 30%,
				color.scale($blue, $alpha: -92%),
				transparent 28%
			),
			$bg;
		color: $white;
		line-height: 1.6;
		font-size: 17px;
		font-weight: 400;
	}
	a {
		color: inherit;
		text-decoration: none;
	}
	h1,
	h2,
	h3,
	.logo,
	.nav-links,
	.nav-cta,
	.btn,
	.eyebrow,
	.kicker,
	.badge,
	.plan-number,
	.price,
	.step-number,
	summary {
		font-family:
			"Plus Jakarta Sans",
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			Arial,
			sans-serif;
	}
	h1,
	h2,
	h3 {
		font-weight: 800;
	}

	/* Text wrapping */
	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		text-wrap: balance;
		overflow-wrap: break-word;
	}

	p {
		text-wrap: pretty;
		overflow-wrap: break-word;
	}

	button,
	input,
	textarea,
	select {
		font-family: inherit;
	}
	.container {
		width: calc(100% - 28px);
		margin: auto;
	}
	section {
		padding: 70px 0;
	}
	header {
		position: sticky;
		top: 0;
		z-index: 1000;
		background: rgba(7, 19, 31, 0.88);
		backdrop-filter: blur(16px);
		border-bottom: 1px solid $border;
	}
	.nav {
		min-height: 70px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.logo {
		font-size: 1.4rem;
		font-weight: 900;
		letter-spacing: -0.5px;
	}
	.logo span {
		color: $primary;
	}
	.nav-links {
		display: none;
		gap: 28px;
	}
	.nav-links a {
		color: $text;
		font-size: 0.88rem;
		font-weight: 600;
	}
	.nav-links a:hover {
		color: $primary;
	}
	.nav-cta {
		padding: 9px 12px;
		border-radius: 999px;
		background: $primary;
		color: #211b10;
		font-size: 0.72rem;
		font-weight: 800;
	}
	.btn {
		min-height: 54px;
		padding: 0 23px;
		border-radius: 13px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		font-weight: 800;
		font-size: 0.88rem;
		transition: 0.2s ease;
	}
	.btn-primary {
		background: $primary;
		color: #211b10;
		box-shadow: 0 12px 35px color.scale($primary, $alpha: -82%);
	}
	.btn-primary:hover {
		background: $primary2;
		transform: translateY(-2px);
	}
	.btn-secondary {
		background: color.scale($white, $alpha: -96%);
		border: 1px solid $border;
	}
	.btn-secondary:hover {
		background: color.scale($white, $alpha: -92%);
	}
	.hero {
		padding: 60px 0 80px;
	}
	.hero-grid {
		display: grid;
		grid-template-columns: 1fr;
		grid-template-areas:
			"content"
			"points"
			"trust"
			"cta";
		gap: 18px;
	}
	.hero-grid__content {
		grid-area: content;
	}
	.hero-grid__cta {
		grid-area: cta;
		width: 100%;
	}
	.eyebrow {
		display: inline-flex;
		gap: 8px;
		align-items: center;
