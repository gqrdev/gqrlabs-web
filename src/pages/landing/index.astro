---
<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="googlebot" content="noindex, nofollow" />
		<title>GQR Labs | Protección Digital con una Persona Real</title>

		<meta
			name="description"
			content="Aprendé a protegerte en internet con una persona real. Mentoría 1:1, capacitación personalizada y acompañamiento digital para personas que buscan más seguridad y tranquilidad."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Roboto+Condensed:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<style>
			:root {
				--bg: #07131f;
				--bg2: #0b1d2c;
				--card: #10283b;
				--primary: #2dd4bf;
				--primary2: #5eead4;
				--blue: #38bdf8;
				--white: #f8fafc;
				--text: #d9e5ed;
				--muted: #91a6b8;
				--border: rgba(255, 255, 255, 0.1);
				--green: #25d366;
				--max: 1120px;
				--radius: 22px;
			}
			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}
			html {
				scroll-behavior: smooth;
			}
			body {
				font-family:
					"Roboto Condensed",
					-apple-system,
					BlinkMacSystemFont,
					"Segoe UI",
					Arial,
					sans-serif;
				background:
					radial-gradient(
						circle at 85% 0%,
						rgba(45, 212, 191, 0.12),
						transparent 28%
					),
					radial-gradient(
						circle at 0% 30%,
						rgba(56, 189, 248, 0.08),
						transparent 28%
					),
					var(--bg);
				color: var(--white);
				line-height: 1.6;
				font-size: 18px;
				font-weight: 400;
			}
			a {
				color: inherit;
				text-decoration: none;
			}
			h1,
			h2,
			h3,
			.logo,
			.nav-links,
			.nav-cta,
			.btn,
			.eyebrow,
			.kicker,
			.badge,
			.plan-number,
			.price,
			.step-number,
			summary {
				font-family:
					"Plus Jakarta Sans",
					-apple-system,
					BlinkMacSystemFont,
					"Segoe UI",
					Arial,
					sans-serif;
			}
			h1,
			h2,
			h3 {
				font-weight: 800;
			}
			button,
			input,
			textarea,
			select {
				font-family: inherit;
			}
			.container {
				width: min(var(--max), calc(100% - 36px));
				margin: auto;
			}
			section {
				padding: 90px 0;
			}
			header {
				position: sticky;
				top: 0;
				z-index: 1000;
				background: rgba(7, 19, 31, 0.88);
				backdrop-filter: blur(16px);
				border-bottom: 1px solid var(--border);
			}
			.nav {
				min-height: 70px;
				display: flex;
				align-items: center;
				justify-content: space-between;
			}
			.logo {
				font-size: 1.4rem;
				font-weight: 900;
				letter-spacing: -0.5px;
			}
			.logo span {
				color: var(--primary);
			}
			.nav-links {
				display: flex;
				gap: 28px;
			}
			.nav-links a {
				color: var(--text);
				font-size: 0.88rem;
				font-weight: 600;
			}
			.nav-links a:hover {
				color: var(--primary);
			}
			.nav-cta {
				padding: 10px 17px;
				border-radius: 999px;
				background: var(--primary);
				color: #04211e;
				font-size: 0.78rem;
				font-weight: 800;
			}
			.btn {
				min-height: 54px;
				padding: 0 23px;
				border-radius: 13px;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 8px;
				font-weight: 800;
				font-size: 0.88rem;
				transition: 0.2s ease;
			}
			.btn-primary {
				background: var(--primary);
				color: #04211e;
				box-shadow: 0 12px 35px rgba(45, 212, 191, 0.18);
			}
			.btn-primary:hover {
				background: var(--primary2);
				transform: translateY(-2px);
			}
			.btn-secondary {
				background: rgba(255, 255, 255, 0.04);
				border: 1px solid var(--border);
			}
			.btn-secondary:hover {
				background: rgba(255, 255, 255, 0.08);
			}
			.hero {
				padding: 95px 0 80px;
			}
			.hero-grid {
				display: grid;
				grid-template-columns: 1.08fr 0.92fr;
				gap: 65px;
				align-items: center;
			}
			.eyebrow {
				display: inline-flex;
				gap: 8px;
				align-items: center;
				padding: 7px 13px;
				border-radius: 999px;
				color: var(--primary);
				background: rgba(45, 212, 191, 0.08);
				border: 1px solid rgba(45, 212, 191, 0.25);
				font-size: 0.72rem;
				font-weight: 800;
				margin-bottom: 22px;
			}
			.dot {
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: var(--primary);
				box-shadow: 0 0 12px var(--primary);
			}
			h1 {
				font-size: clamp(2.8rem, 6vw, 5.3rem);
				line-height: 0.98;
				letter-spacing: -3.5px;
				margin-bottom: 25px;
			}
			h1 span {
				color: var(--primary);
			}
			.hero-text {
				color: var(--text);
				font-size: 1.12rem;
				line-height: 1.55;
				max-width: 650px;
				margin-bottom: 28px;
			}
			.hero-text strong {
				color: white;
				font-weight: 700;
			}
			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
				margin-bottom: 22px;
			}
			.trust {
				display: flex;
				flex-wrap: wrap;
				gap: 17px;
				color: var(--muted);
				font-size: 0.85rem;
			}
			.trust span::before {
				content: "✓";
				color: var(--primary);
				font-weight: 900;
				margin-right: 5px;
			}
			.person-card {
				background: linear-gradient(145deg, #123349, #091d2d);
				border: 1px solid var(--border);
				border-radius: 28px;
				padding: 32px;
				box-shadow: 0 25px 70px rgba(0, 0, 0, 0.35);
			}
			.photo {
				width: 145px;
				height: 145px;
				margin: 0 auto 20px;
				border-radius: 50%;
				display: grid;
				place-items: center;
				background: #12384d;
				border: 4px solid rgba(45, 212, 191, 0.4);
				color: var(--primary);
				font-size: 2.7rem;
				overflow: hidden;
			}
			.photo img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.person-card h2 {
				text-align: center;
				font-size: 1.45rem;
				margin-bottom: 5px;
				line-height: 1.2;
			}
			.role {
				text-align: center;
				color: var(--primary);
				font-weight: 700;
				font-size: 0.84rem;
				margin-bottom: 15px;
			}
			.person-card p {
				color: var(--muted);
				text-align: center;
				margin-bottom: 22px;
				font-size: 1rem;
				line-height: 1.5;
			}
			.person-points {
				display: grid;
				gap: 9px;
			}
			.point {
				display: flex;
				align-items: center;
				gap: 10px;
				padding: 11px 13px;
				border-radius: 11px;
				background: rgba(255, 255, 255, 0.04);
				color: var(--text);
				font-size: 0.95rem;
			}
			.kicker {
				color: var(--primary);
				text-transform: uppercase;
				letter-spacing: 1.5px;
				font-size: 0.7rem;
				font-weight: 900;
				margin-bottom: 9px;
			}
			.section-title {
				font-size: clamp(2rem, 4vw, 3.2rem);
				line-height: 1.07;
				letter-spacing: -1.6px;
				margin-bottom: 14px;
			}
			.section-intro {
				color: var(--muted);
				max-width: 720px;
				font-size: 1rem;
				line-height: 1.55;
			}
			.section-head {
				margin-bottom: 43px;
			}
			.human-box {
				display: grid;
				grid-template-columns: 0.8fr 1.2fr;
				gap: 50px;
				align-items: center;
				padding: 52px;
				border-radius: 28px;
				background: linear-gradient(
					135deg,
					rgba(45, 212, 191, 0.08),
					rgba(56, 189, 248, 0.04)
				);
				border: 1px solid rgba(45, 212, 191, 0.22);
			}
			.human-box h2 {
				font-size: clamp(2rem, 4vw, 3.1rem);
				line-height: 1.05;
				letter-spacing: -1.5px;
			}
			.human-box p {
				color: var(--text);
				margin-bottom: 15px;
				line-height: 1.55;
			}
			.quote {
				margin-top: 18px;
				padding: 18px;
				border-left: 3px solid var(--primary);
				background: rgba(0, 0, 0, 0.14);
				font-weight: 700;
			}
			.problem-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 18px;
			}
			.card {
				padding: 27px;
				border-radius: var(--radius);
				border: 1px solid var(--border);
				background: rgba(255, 255, 255, 0.035);
			}
			.icon {
				width: 45px;
				height: 45px;
				display: grid;
				place-items: center;
				border-radius: 12px;
				background: rgba(45, 212, 191, 0.1);
				margin-bottom: 17px;
				font-size: 1.25rem;
			}
			.card h3 {
				margin-bottom: 7px;
				font-size: 1.05rem;
				line-height: 1.25;
			}
			.card p {
				color: var(--muted);
				font-size: 0.98rem;
				line-height: 1.5;
			}
			.steps {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 17px;
			}
			.step-number {
				width: 42px;
				height: 42px;
				display: grid;
				place-items: center;
				border-radius: 12px;
				background: var(--primary);
				color: #04211e;
				font-weight: 900;
				margin-bottom: 18px;
			}
			.plans {
				background: linear-gradient(
					180deg,
					rgba(16, 40, 59, 0.45),
					transparent
				);
			}
			.plans-head {
				text-align: center;
				max-width: 760px;
				margin: 0 auto 45px;
			}
			.plans-head .section-intro {
				margin: auto;
			}
			.plan-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 20px;
				align-items: stretch;
			}
			@media (min-width: 768px) {
				.plan-grid {
					grid-template-columns: repeat(3, 1fr);
				}
			}
			.plan {
				display: flex;
				flex-direction: column;
				padding: 30px;
				border-radius: 24px;
				background: linear-gradient(155deg, #10283b, #091d2d);
				border: 1px solid var(--border);
			}
			.plan.featured {
				border: 2px solid var(--primary);
				box-shadow: 0 25px 65px rgba(45, 212, 191, 0.09);
			}
			.badge {
				align-self: flex-start;
				padding: 6px 10px;
				border-radius: 999px;
				background: var(--primary);
				color: #04211e;
				text-transform: uppercase;
				font-size: 0.63rem;
				font-weight: 900;
				margin-bottom: 16px;
			}
			.plan-number {
				color: var(--primary);
				font-size: 0.68rem;
				font-weight: 900;
				letter-spacing: 1.3px;
				text-transform: uppercase;
				margin-bottom: 8px;
			}
			.plan h3 {
				font-size: 1.25rem;
				margin-bottom: 9px;
				line-height: 1.2;
			}
			.plan-subtitle {
				color: var(--primary);
				font-weight: 700;
				margin-bottom: 15px;
			}
			.plan p {
				color: var(--muted);
				font-size: 0.98rem;
				line-height: 1.5;
				margin-bottom: 19px;
			}
			.plan ul {
				list-style: none;
				display: grid;
				gap: 10px;
				margin-bottom: 27px;
			}
			.plan li {
				color: var(--text);
				font-size: 0.95rem;
			}
			.plan li::before {
				content: "✓";
				color: var(--primary);
				font-weight: 900;
				margin-right: 8px;
			}
			.plan .btn {
				width: 100%;
				margin-top: auto;
			}
			.price {
				font-size: 2rem;
				font-weight: 900;
				margin-bottom: 18px;
			}
			.price small {
				color: var(--muted);
				font-size: 0.7rem;
				font-weight: 500;
			}
			.price-note {
				text-align: center;
				color: var(--muted);
				font-size: 0.75rem;
				margin-top: 19px;
			}
			.vip {
				padding-top: 40px;
			}
			.vip-box {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 45px;
				align-items: center;
				padding: 50px;
				border-radius: 30px;
				background: linear-gradient(135deg, #0b2c36, #081b2a);
				border: 1px solid rgba(45, 212, 191, 0.28);
			}
			.vip-box h2 {
				font-size: clamp(2rem, 4vw, 3.1rem);
				line-height: 1.05;
				margin-bottom: 15px;
				letter-spacing: -1.5px;
			}
			.vip-box p {
				color: var(--text);
				margin-bottom: 20px;
				line-height: 1.55;
			}
			.vip-list {
				display: grid;
				gap: 11px;
				list-style: none;
			}
			.vip-list li {
				color: var(--text);
			}
			.vip-list li::before {
				content: "✓";
				color: var(--primary);
				font-weight: 900;
				margin-right: 8px;
			}
			.faq {
				max-width: 820px;
				margin: auto;
			}
			details {
				background: rgba(255, 255, 255, 0.035);
				border: 1px solid var(--border);
				border-radius: 14px;
				margin-bottom: 10px;
			}
			summary {
				cursor: pointer;
				list-style: none;
				padding: 19px 21px;
				font-weight: 800;
				font-size: 0.92rem;
			}
			summary::-webkit-details-marker {
				display: none;
			}
			summary::after {
				content: "+";
				float: right;
				color: var(--primary);
				font-size: 1.2rem;
			}
			details[open] summary::after {
				content: "−";
			}
			details p {
				color: var(--muted);
				padding: 0 21px 20px;
				font-size: 1rem;
				line-height: 1.55;
			}
			.cta {
				text-align: center;
				padding: 100px 0;
			}
			.cta h2 {
				max-width: 800px;
				margin: 0 auto 15px;
				font-size: clamp(2.2rem, 4vw, 3.5rem);
				line-height: 1.05;
				letter-spacing: -1.7px;
			}
			.cta p {
				color: var(--muted);
				max-width: 650px;
				margin: 0 auto 27px;
				line-height: 1.55;
			}
			footer {
				border-top: 1px solid var(--border);
				padding: 30px 0;
				color: var(--muted);
				font-size: 0.8rem;
			}
			.footer-inner {
				display: flex;
				justify-content: space-between;
				gap: 20px;
			}
			.float-whatsapp {
				display: none;
				position: fixed;
				right: 18px;
				bottom: 18px;
				z-index: 900;
				width: 58px;
				height: 58px;
				place-items: center;
				border-radius: 50%;
				background: var(--green);
				color: white;
				font-size: 1.5rem;
				box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
			}
			@media (max-width: 950px) {
				.hero-grid,
				.human-box,
				.vip-box {
					grid-template-columns: 1fr;
				}
				.problem-grid {
					grid-template-columns: 1fr;
				}
				.steps {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			@media (max-width: 650px) {
				body {
					font-size: 17px;
				}
				.container {
					width: calc(100% - 28px);
				}
				section {
					padding: 70px 0;
				}
				.hero {
					padding-top: 60px;
				}
				h1 {
					font-size: 2.85rem;
					letter-spacing: -2.2px;
				}
				.nav-links {
					display: none;
				}
				.nav-cta {
					font-size: 0.72rem;
					padding: 9px 12px;
				}
				.hero-actions {
					flex-direction: column;
				}
				.hero-actions .btn {
					width: 100%;
				}
				.trust {
					display: grid;
					gap: 7px;
				}
				.human-box,
				.vip-box {
					padding: 32px 23px;
				}
				.steps {
					grid-template-columns: 1fr;
				}
				.float-whatsapp {
					display: grid;
				}
				.footer-inner {
					flex-direction: column;
					text-align: center;
				}
			}
		</style>
	</head>
	<body>
		<header>
			<div class="container nav">
				<a href="https://gqrlabs.com/" class="logo">
					GQR<span>Labs</span>
				</a>

				<nav class="nav-links">
					<a href="#como-funciona">Cómo funciona</a>
					<a href="#planes">Opciones</a>
					<a href="#preguntas">Preguntas</a>
				</nav>

				<a
					class="nav-cta"
					target="_blank"
					rel="noopener"
					href="https://wa.me/598XXXXXXXX?text=Hola%2C%20vi%20la%20p%C3%A1gina%20de%20GQR%20Labs%20y%20quiero%20hablar%20con%20una%20persona."
				>
					Hablar con una persona
				</a>
			</div>
		</header>
		<main>
			<section class="hero">
				<div class="container hero-grid">
					<div>
						<div class="eyebrow">
							<span class="dot"></span>
							Protección digital personalizada
						</div>

						<h1>
							Tu seguridad digital.
							<span>Explicada por una persona.</span>
						</h1>

						<p class="hero-text">
							No necesitás saber de informática para estar más seguro.

							<strong> Hablá con una persona real de GQR Labs </strong>

							y encontrá la forma de aprender y protegerte que mejor se adapte a
							vos.
						</p>

						<div class="hero-actions">
							<a
								class="btn btn-primary"
								target="_blank"
								rel="noopener"
								href="https://wa.me/598XXXXXXXX?text=Hola%2C%20vi%20la%20p%C3%A1gina%20de%20GQR%20Labs%20y%20quiero%20hablar%20con%20una%20persona%20sobre%20mi%20seguridad%20digital."
							>
								💬 Quiero hablar con una persona
							</a>

							<a class="btn btn-secondary" href="#planes"> Ver las opciones </a>
						</div>

						<div class="trust">
							<span>Sin tecnicismos</span>
							<span>Atención 1:1</span>
							<span>Adaptado a vos</span>
						</div>
					</div>

					<div class="person-card">
						<div class="photo">👤</div>

						<h2>Hay una persona del otro lado.</h2>

						<div class="role">GQR Labs · Protección Digital</div>

						<p>
							Podés contarme qué te preocupa con tus propias palabras. No
							necesitás saber de tecnología para empezar.
						</p>

						<div class="person-points">
							<div class="point">
